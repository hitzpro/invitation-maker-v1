---
const {
  name, label, value = '', error = '', type = 'text',
  placeholder = '', maxlength, rows, required = false, hint = '',
} = Astro.props;
---
<div>
  <label for={name} class="block text-sm font-medium">
    {label}{required && <span class="text-red-600"> *</span>}
  </label>
  {rows ? (
    <textarea id={name} name={name} rows={rows} maxlength={maxlength} placeholder={placeholder}
      class="mt-1 w-full border rounded px-3 py-2">{value}</textarea>
  ) : (
    <input id={name} name={name} type={type} value={value} maxlength={maxlength}
      placeholder={placeholder} required={required}
      class="mt-1 w-full border rounded px-3 py-2" />
  )}
  {hint && <p class="text-xs text-gray-600 mt-1">{hint}</p>}
  {error && <p class="text-sm text-red-600 mt-1">{error}</p>}
</div>