---
const {
  name, label, value = '', error = '', type = 'text',
  placeholder = '', maxlength, rows, required = false, hint = '',
} = Astro.props;
---
<div>
  <label for={name} class="block text-sm font-medium text-[#493D35]">
    {label}{required && <span class="text-[#A34E4E]"> *</span>}
  </label>
  {rows ? (
    <textarea id={name} name={name} rows={rows} maxlength={maxlength} placeholder={placeholder}
      class="input-field mt-1.5">{value}</textarea>
  ) : (
    <input id={name} name={name} type={type} value={value} maxlength={maxlength}
      placeholder={placeholder} required={required}
      class="input-field mt-1.5" />
  )}
  {hint && <p class="mt-1.5 text-xs text-[#6C5E54]">{hint}</p>}
  {error && <p class="mt-1.5 text-sm text-[#A34E4E]">{error}</p>}
</div>