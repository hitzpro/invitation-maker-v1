---
const { invitationId } = Astro.props;
---
<form data-upload-form action={`/api/invitations/${invitationId}/assets`} method="POST"
  enctype="multipart/form-data" class="flex flex-wrap items-center gap-3">
  <input type="file" name="file" accept="image/jpeg,image/png" multiple
    class="text-sm text-[#493D35] file:mr-3 file:rounded-[8px] file:border file:border-[#D8C8B5] file:bg-[#F5F0E8] file:px-3 file:py-1.5 file:text-xs file:font-medium file:text-[#493D35] hover:file:border-[#8B7561]" />
  <button class="btn-primary">Unggah</button>
</form>
<p data-upload-error class="mt-2 text-sm text-[#A34E4E]"></p>

<script>
  document.querySelectorAll('form[data-upload-form]').forEach((form) => {
    const errorEl = form.nextElementSibling;
    const input = form.querySelector('input[type=file]');
    const btn = form.querySelector('button');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.textContent = '';
      const files = [...input.files];
      if (files.length === 0) {
        errorEl.textContent = 'Pilih file terlebih dahulu';
        return;
      }

      btn.disabled = true;
      const errors = [];
      let ok = 0;

      for (const [i, file] of files.entries()) {
        btn.textContent = `Mengunggah ${i + 1}/${files.length}...`;
        const fd = new FormData();
        fd.append('file', file);
        try {
          const res = await fetch(form.action, { method: 'POST', body: fd });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error ?? 'Gagal mengunggah');
          ok++;
        } catch (err) {
          errors.push(`${file.name}: ${err.message}`);
        }
      }

      if (errors.length === 0) {
        location.assign(location.pathname + location.search);
        return;
      }
      errorEl.textContent =
        errors.join(' | ') + (ok ? ` (${ok} berhasil, muat ulang halaman untuk melihatnya)` : '');
      btn.disabled = false;
      btn.textContent = 'Unggah';
    });
  });
</script>