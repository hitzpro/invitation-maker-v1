---
import { MAX_GALLERY } from '../../lib/content-schema.js';
---
<div data-photo-gallery="sections.gallery.imageIds" data-max={MAX_GALLERY} class="space-y-3">
  <p data-gallery-empty class="text-xs leading-relaxed text-[#6C5E54]">
    Belum ada foto galeri. Section ini otomatis tersembunyi bila kosong.
  </p>
  <ul data-gallery-items class="grid grid-cols-3 gap-2"></ul>
  <button type="button" data-gallery-add class="btn-secondary w-full py-2 text-xs">
    Tambah Foto Galeri
  </button>
  <p class="text-xs text-[#A34E4E]" data-error-for="sections.gallery.imageIds"></p>
</div>