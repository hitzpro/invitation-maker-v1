---
import { MAX_GALLERY } from '../../lib/content-schema.js';
---
<div data-photo-gallery="sections.gallery.imageIds" data-max={MAX_GALLERY}>
  <p data-gallery-empty class="text-sm text-gray-500">Belum ada foto galeri. Section ini otomatis tersembunyi bila kosong.</p>
  <ul data-gallery-items class="mt-2 grid grid-cols-3 gap-2"></ul>
  <button type="button" data-gallery-add
    class="mt-3 rounded border px-3 py-1.5 text-sm hover:bg-gray-50 disabled:opacity-40">+ Tambah foto</button>
  <p class="mt-1 text-sm text-red-600" data-error-for="sections.gallery.imageIds"></p>
</div>