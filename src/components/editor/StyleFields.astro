---
const { sectionKey } = Astro.props;
const base = `sections.${sectionKey}.style`;
const id = (name) => `f-${sectionKey}-${name}`;
const selectClass = 'mt-1 w-full rounded border bg-white px-2 py-1.5 text-sm';

const SURFACES = [
  ['plain', 'Polos'],
  ['white', 'Putih'],
  ['tint', 'Tint warna tema'],
  ['solid', 'Warna tema penuh'],
];

const LAYOUT_HINTS = {
  couple: 'Split: kedua mempelai berdampingan.',
  event: 'Split: kartu acara berdampingan.',
  countdown: 'Split: judul di kiri, hitungan di kanan.',
  location: 'Split: teks di kiri, tombol di kanan.',
  closing: 'Split: pesan di kiri, nama di kanan.',
};

const FRAMES = [
  ['circle', 'Lingkaran'],
  ['rounded', 'Kotak membulat'],
  ['arch', 'Lengkung'],
  ['oval', 'Oval'],
  ['hexagon', 'Segi enam'],
  ['heart', 'Hati'],
];

const GALLERY_LAYOUTS = [
  ['grid', 'Grid'],
  ['carousel', 'Geser ke samping'],
  ['masonry', 'Masonry'],
  ['mosaic', 'Mosaik'],
];

const TIMELINES = [
  ['line', 'Garis di kiri'],
  ['alternate', 'Zig-zag'],
  ['cards', 'Kartu'],
  ['minimal', 'Minimal'],
];
---
<div class="space-y-3 rounded border bg-gray-50 p-3">
  <p class="text-sm font-medium">Gaya section</p>

  {Object.hasOwn(LAYOUT_HINTS, sectionKey) && (
    <div>
      <label for={id('layout')} class="block text-xs text-gray-600">Tata letak</label>
      <select id={id('layout')} data-bind={`${base}.layout`} class={selectClass}>
        <option value="centered">Terpusat</option>
        <option value="split">Split (dua kolom)</option>
      </select>
      <p class="mt-1 text-xs text-gray-500">{LAYOUT_HINTS[sectionKey]}</p>
    </div>
  )}

  {sectionKey === 'couple' && (
    <div>
      <label for={id('frame')} class="block text-xs text-gray-600">Bingkai foto mempelai</label>
      <select id={id('frame')} data-bind={`${base}.frame`} class={selectClass}>
        {FRAMES.map(([value, label]) => <option value={value}>{label}</option>)}
      </select>
    </div>
  )}

  {sectionKey === 'story' && (
    <div>
      <label for={id('timeline')} class="block text-xs text-gray-600">Gaya timeline</label>
      <select id={id('timeline')} data-bind={`${base}.timeline`} class={selectClass}>
        {TIMELINES.map(([value, label]) => <option value={value}>{label}</option>)}
      </select>
    </div>
  )}

  {sectionKey === 'gallery' && (
    <div>
      <label for={id('gallery-layout')} class="block text-xs text-gray-600">Tata letak galeri</label>
      <select id={id('gallery-layout')} data-bind={`${base}.layout`} class={selectClass}>
        {GALLERY_LAYOUTS.map(([value, label]) => <option value={value}>{label}</option>)}
      </select>
    </div>
  )}

  <div>
    <label for={id('surface')} class="block text-xs text-gray-600">Latar</label>
    <select id={id('surface')} data-bind={`${base}.surface`} class={selectClass}>
      {SURFACES.map(([value, label]) => <option value={value}>{label}</option>)}
    </select>
  </div>

  <label class="flex items-center gap-2 text-sm">
    <input type="checkbox" data-bind={`${base}.pattern`} data-style-flag="pattern" /> Pakai pola latar
  </label>
  <label class="flex items-center gap-2 text-sm">
    <input type="checkbox" data-bind={`${base}.animate`} data-style-flag="animate" />
    {sectionKey === 'gallery' || sectionKey === 'story' ? 'Animasi fade-in per item' : 'Animasi fade-in'}
  </label>
  <p class="text-xs text-gray-500">
    Dua kotak centang di atas aktif bila fiturnya dinyalakan di "Tema dan warna" dan opsi "Terapkan ke semua section" dimatikan.
  </p>
</div>