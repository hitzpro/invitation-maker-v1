---
import EField from './EField.astro';
import PhotoField from './PhotoField.astro';

const blank = JSON.stringify({ bank: '', number: '', holder: '' });
---
<EField path="sections.gift.intro" label="Kalimat pengantar" rows="3" maxlength="400" />
<PhotoField path="sections.gift.qrisImageId" label="Gambar QRIS (opsional)" />

<div data-list="sections.gift.accounts" data-max="5" data-blank={blank} class="space-y-3">
  <p data-empty class="text-sm text-gray-500">Belum ada rekening. Section otomatis tersembunyi bila rekening dan QRIS kosong.</p>
  <div data-items class="space-y-3"></div>
  <button type="button" data-add-item
    class="rounded border px-3 py-1.5 text-sm hover:bg-gray-50 disabled:opacity-40">+ Tambah rekening</button>

  <template>
    <div class="space-y-2 rounded border p-3">
      <div class="flex items-center justify-between">
        <p class="text-sm font-medium">Rekening <span data-item-number></span></p>
        <button type="button" data-remove-item class="text-sm text-red-600 underline">Hapus</button>
      </div>
      <EField path="sections.gift.accounts.__i__.bank" label="Bank / E-Wallet" maxlength="40" placeholder="BCA / Mandiri / GoPay" />
      <EField path="sections.gift.accounts.__i__.number" label="Nomor rekening / HP" maxlength="40" />
      <EField path="sections.gift.accounts.__i__.holder" label="Atas nama" maxlength="80" />
    </div>
  </template>
</div>