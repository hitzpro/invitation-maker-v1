---
import { SECTION_LABELS } from '../../lib/render-data.js';
import { SECTION_ORDER } from '../../lib/content.js';
import { MAX_DECORATIONS } from '../../lib/content-schema.js';

const blank = JSON.stringify({ kind: 'flower', assetId: null, section: 'couple', position: 'top-left', size: 'md', flip: false });

const KINDS = [
  ['flower', 'Bunga'], ['branch', 'Ranting daun'], ['corner', 'Sudut bunga'],
  ['divider', 'Pembatas'], ['sparkle', 'Kilau'], ['custom', 'SVG unggahan'],
];
const POSITIONS = [
  ['top-left', 'Kiri atas'], ['top-center', 'Tengah atas'], ['top-right', 'Kanan atas'],
  ['bottom-left', 'Kiri bawah'], ['bottom-center', 'Tengah bawah'], ['bottom-right', 'Kanan bawah'],
];
const SIZES = [['sm', 'Kecil'], ['md', 'Sedang'], ['lg', 'Besar']];
const selectClass = 'input-field mt-1 py-1.5 text-xs';
---
<div data-list="decorations" data-max={MAX_DECORATIONS} data-blank={blank} class="space-y-4">
  <p class="text-xs leading-relaxed text-[#6C5E54]">
    Warna hiasan mengikuti warna tema. Di sampul dan latar warna tema penuh, hiasan otomatis berwarna putih.
  </p>

  <div data-ornaments class="space-y-2.5 border-y border-[#D8C8B5] py-4">
    <div class="flex items-center justify-between gap-2">
      <p class="text-xs font-medium text-[#493D35]">Koleksi SVG unggahan</p>
      <label class="btn-secondary cursor-pointer px-3 py-1 text-xs">
        Unggah SVG
        <input type="file" accept=".svg,image/svg+xml" class="hidden" data-ornament-upload />
      </label>
    </div>
    <p data-ornament-msg class="text-xs text-[#A34E4E]"></p>
    <ul data-ornament-list class="space-y-1.5"></ul>
  </div>

  <p data-empty class="text-sm text-[#6C5E54]">Belum ada hiasan terpasang.</p>
  <div data-items class="space-y-4"></div>
  <button type="button" data-add-item class="btn-secondary w-full py-2 text-xs">
    Tambah Hiasan
  </button>
  <p class="text-xs text-[#A34E4E]" data-error-for="decorations"></p>

  <template>
    <div class="space-y-2.5 border-b border-[#D8C8B5] pb-4">
      <div class="flex items-center justify-between">
        <p class="text-xs font-medium uppercase tracking-wider text-[#493D35]">
          Hiasan <span data-item-number></span>
        </p>
        <button type="button" data-remove-item class="text-xs font-medium text-[#A34E4E] underline underline-offset-4">
          Hapus
        </button>
      </div>
      <div class="grid grid-cols-2 gap-2.5">
        <label class="block text-xs text-[#6C5E54]">Jenis
          <select data-bind="decorations.__i__.kind" class={selectClass}>
            {KINDS.map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </label>
        <label class="block text-xs text-[#6C5E54]">Di section
          <select data-bind="decorations.__i__.section" class={selectClass}>
            {SECTION_ORDER.map((key) => <option value={key}>{SECTION_LABELS[key]}</option>)}
          </select>
        </label>
        <label class="block text-xs text-[#6C5E54]">Posisi
          <select data-bind="decorations.__i__.position" class={selectClass}>
            {POSITIONS.map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </label>
        <label class="block text-xs text-[#6C5E54]">Ukuran
          <select data-bind="decorations.__i__.size" class={selectClass}>
            {SIZES.map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </label>
      </div>
      <div data-ornament-picker class="hidden">
        <label class="block text-xs text-[#6C5E54]">Pilih SVG
          <select data-bind="decorations.__i__.assetId" data-ornament-select class={selectClass}></select>
        </label>
        <p class="mt-1 text-xs text-[#A34E4E]" data-error-for="decorations.__i__.assetId"></p>
      </div>
      <label class="flex items-center gap-2 text-xs text-[#493D35]">
        <input type="checkbox" data-bind="decorations.__i__.flip" class="accent-[#8B7561]" />
        Cerminkan horizontal
      </label>
    </div>
  </template>
</div>