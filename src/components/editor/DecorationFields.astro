---
import { SECTION_LABELS } from '../../lib/render-data.js';
import { SECTION_ORDER } from '../../lib/content.js';
import { MAX_DECORATIONS } from '../../lib/content-schema.js';

const blank = JSON.stringify({ kind: 'flower', assetId: null, section: 'couple', position: 'top-left', size: 'md', flip: false });

const KINDS = [
  ['flower', 'Bunga'], ['branch', 'Ranting daun'], ['corner', 'Sudut bunga'],
  ['divider', 'Pembatas'], ['sparkle', 'Kilau'], ['custom', 'SVG unggahan'],
];
const POSITIONS = [
  ['top-left', 'Kiri atas'], ['top-center', 'Tengah atas'], ['top-right', 'Kanan atas'],
  ['bottom-left', 'Kiri bawah'], ['bottom-center', 'Tengah bawah'], ['bottom-right', 'Kanan bawah'],
];
const SIZES = [['sm', 'Kecil'], ['md', 'Sedang'], ['lg', 'Besar']];
const selectClass = 'mt-1 w-full rounded border bg-white px-2 py-1.5 text-sm';
---
<div data-list="decorations" data-max={MAX_DECORATIONS} data-blank={blank} class="space-y-3">
  <p class="text-xs text-gray-500">Warna hiasan mengikuti warna tema. Di cover dan latar "Warna tema penuh", hiasan berwarna putih.</p>
  <div data-ornaments class="space-y-2 rounded border bg-gray-50 p-3">
    <div class="flex items-center justify-between gap-2">
      <p class="text-xs font-medium text-gray-700">Koleksi SVG unggahan</p>
      <label class="cursor-pointer rounded border bg-white px-2.5 py-1 text-xs hover:bg-gray-100">
        + Unggah SVG
        <input type="file" accept=".svg,image/svg+xml" class="hidden" data-ornament-upload />
      </label>
    </div>
    <p data-ornament-msg class="text-xs text-red-600"></p>
    <ul data-ornament-list class="space-y-1"></ul>
  </div>
  <p data-empty class="text-sm text-gray-500">Belum ada hiasan.</p>
  <div data-items class="space-y-3"></div>
  <button type="button" data-add-item
    class="rounded border px-3 py-1.5 text-sm hover:bg-gray-50 disabled:opacity-40">+ Tambah hiasan</button>
  <p class="text-sm text-red-600" data-error-for="decorations"></p>

  <template>
    <div class="space-y-2 rounded border p-3">
      <div class="flex items-center justify-between">
        <p class="text-sm font-medium">Hiasan <span data-item-number></span></p>
        <button type="button" data-remove-item class="text-sm text-red-600 underline">Hapus</button>
      </div>
      <div class="grid grid-cols-2 gap-2">
        <label class="block text-xs text-gray-600">Jenis
          <select data-bind="decorations.__i__.kind" class={selectClass}>
            {KINDS.map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </label>
        <label class="block text-xs text-gray-600">Di section
          <select data-bind="decorations.__i__.section" class={selectClass}>
            {SECTION_ORDER.map((key) => <option value={key}>{SECTION_LABELS[key]}</option>)}
          </select>
        </label>
        <label class="block text-xs text-gray-600">Posisi
          <select data-bind="decorations.__i__.position" class={selectClass}>
            {POSITIONS.map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </label>
        <label class="block text-xs text-gray-600">Ukuran
          <select data-bind="decorations.__i__.size" class={selectClass}>
            {SIZES.map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </label>
      </div>
      <div data-ornament-picker class="hidden">
        <label class="block text-xs text-gray-600">Pilih SVG
          <select data-bind="decorations.__i__.assetId" data-ornament-select class={selectClass}></select>
        </label>
        <p class="mt-1 text-xs text-red-600" data-error-for="decorations.__i__.assetId"></p>
      </div>
      <label class="flex items-center gap-2 text-sm">
        <input type="checkbox" data-bind="decorations.__i__.flip" /> Cerminkan
      </label>
    </div>
  </template>
</div>