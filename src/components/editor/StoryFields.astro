---
import EField from './EField.astro';
import { MAX_STORIES } from '../../lib/content-schema.js';

const blank = JSON.stringify({ title: '', date: '', text: '' });
---
<div data-list="sections.story.items" data-max={MAX_STORIES} data-blank={blank} class="space-y-4">
  <p data-empty class="text-xs leading-relaxed text-[#6C5E54]">
    Belum ada kisah. Tambahkan momen perjalanan Anda, atau nonaktifkan section ini bila tidak diperlukan.
  </p>
  <div data-items class="space-y-5"></div>
  <button type="button" data-add-item class="btn-secondary w-full py-2 text-xs">
    Tambah Momen Cerita
  </button>

  <template>
    <div class="space-y-3 border-b border-[#D8C8B5] pb-5">
      <div class="flex items-center justify-between">
        <p class="text-xs font-medium uppercase tracking-wider text-[#493D35]">Cerita <span data-item-number></span></p>
        <button type="button" data-remove-item class="text-xs font-medium text-[#A34E4E] underline underline-offset-4">Hapus</button>
      </div>
      <div class="grid grid-cols-2 gap-2.5">
        <EField path="sections.story.items.__i__.title" label="Judul" maxlength="80" placeholder="Pertemuan pertama" />
        <EField path="sections.story.items.__i__.date" label="Waktu" maxlength="40" placeholder="Mei 2019" />
      </div>
      <EField path="sections.story.items.__i__.text" label="Cerita" rows="3" maxlength="600" />
    </div>
  </template>
</div>