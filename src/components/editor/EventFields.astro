---
import EField from './EField.astro';
import { TIMEZONES } from '../../lib/content.js';
import { MAX_EVENTS } from '../../lib/content-schema.js';

const blank = JSON.stringify({
  key: '', label: '', date: '', startTime: '', endTime: '', venue: '', address: '',
});
---
<div class="space-y-5">
  <p class="rounded-[9px] border border-[#D8C8B5] bg-[#F5F0E8]/60 px-3 py-2 text-xs leading-relaxed text-[#6C5E54]">
    Bagian Acara dan Countdown otomatis tampil setelah minimal satu acara memiliki tanggal yang valid.
  </p>

  <div>
    <label for="f-event-timezone" class="block text-sm font-medium text-[#493D35]">Zona waktu</label>
    <select id="f-event-timezone" data-bind="sections.event.timezone" class="input-field mt-1.5 py-2 text-sm">
      {Object.entries(TIMEZONES).map(([tz, label]) => <option value={tz}>{label}</option>)}
    </select>
    <p class="mt-1 text-xs text-[#A34E4E]" data-error-for="sections.event.timezone"></p>
  </div>

  <div data-list="sections.event.items" data-max={MAX_EVENTS} data-blank={blank} class="space-y-4 border-t border-[#D8C8B5] pt-4">
    <p data-empty class="text-xs leading-relaxed text-[#6C5E54]">
      Belum ada acara ditambahkan.
    </p>
    <div data-items class="space-y-5"></div>
    <button type="button" data-add-item class="btn-secondary w-full py-2 text-xs">
      Tambah Acara
    </button>

    <template>
      <div class="space-y-3 border-b border-[#D8C8B5] pb-5">
        <div class="flex items-center justify-between">
          <p class="text-xs font-medium uppercase tracking-wider text-[#493D35]">Acara <span data-item-number></span></p>
          <button type="button" data-remove-item class="text-xs font-medium text-[#A34E4E] underline underline-offset-4">Hapus</button>
        </div>
        <EField path="sections.event.items.__i__.label" label="Nama acara" list="event-labels" maxlength="60"
          placeholder="Akad Nikah" />
        <div class="grid grid-cols-3 gap-2">
          <EField path="sections.event.items.__i__.date" label="Tanggal" type="date" />
          <EField path="sections.event.items.__i__.startTime" label="Mulai" type="time" />
          <EField path="sections.event.items.__i__.endTime" label="Selesai" type="time" />
        </div>
        <EField path="sections.event.items.__i__.venue" label="Nama tempat" maxlength="120" />
        <EField path="sections.event.items.__i__.address" label="Alamat" rows="2" maxlength="300" />
      </div>
    </template>
  </div>

  <datalist id="event-labels">
    <option value="Akad Nikah"></option>
    <option value="Resepsi"></option>
    <option value="Ngunduh Mantu"></option>
    <option value="Syukuran"></option>
  </datalist>
</div>