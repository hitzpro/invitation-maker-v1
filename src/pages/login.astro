---
import AuthLayout from '../layouts/AuthLayout.astro';
import { eq } from 'drizzle-orm';
import { db } from '../db/index.js';
import { users } from '../db/schema.js';
import { verifyPassword } from '../lib/password.js';
import { createSession, setSessionCookie } from '../lib/session.js';
import { clientIp, isRateLimited } from '../lib/guest.js';
import { isRegistrationAllowed } from '../lib/settings.js';
import { isDemoMode } from '../lib/demo.js';
import { getCreatorBranding } from '../lib/branding.js';

if (Astro.locals.user) return Astro.redirect('/dashboard');

const demoMode = isDemoMode();
const creator = getCreatorBranding();

if (demoMode && Astro.request.method === 'POST') {
  return new Response('Login dinonaktifkan pada mode demo showcase', { status: 403 });
}

let error = '';
let email = '';
const canRegister = demoMode ? false : await isRegistrationAllowed();

if (!demoMode && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '').trim().toLowerCase();
  const password = String(form.get('password') ?? '');
  const ip = clientIp(Astro.request, Astro.clientAddress);

  if (isRateLimited(`login:${ip}`, 10, 15 * 60 * 1000)) {
    Astro.response.status = 429;
    error = 'Terlalu banyak percobaan masuk. Coba lagi 15 menit lagi.';
  } else {
    const [user] = await db.select().from(users).where(eq(users.email, email)).limit(1);
    const valid = user && user.isActive && (await verifyPassword(user.passwordHash, password));

    if (!valid) {
      error = 'Email atau password salah';
    } else {
      const { token, expiresAt } = await createSession(user.id);
      setSessionCookie(Astro.cookies, token, expiresAt, Astro.request);
      return Astro.redirect(user.role === 'admin' ? '/admin' : '/dashboard');
    }
  }
}
---
<AuthLayout
  title={demoMode ? 'Mode Demo Showcase' : 'Masuk'}
  subtitle={demoMode
    ? 'Halaman login dan dashboard hanya aktif saat aplikasi dijalankan secara lokal.'
    : 'Masuk untuk mengelola undangan pernikahan dan daftar tamu Anda.'}
>
  {demoMode ? (
    <div class="space-y-5">
      <p class="text-sm leading-relaxed text-[#6C5E54]">
        Deployment publik ini berfungsi sebagai pratinjau demo. Untuk membuat akun, masuk ke dashboard, dan menggunakan editor undangan penuh dengan database sendiri, silakan clone repositori dari GitHub dan jalankan di perangkat atau server lokal Anda.
      </p>
      <div class="flex flex-col gap-3">
        <a href="/demo" class="btn-primary w-full py-2.5 text-center">
          Lihat Demo Undangan
        </a>
        <a href="/#jalankan-lokal" class="btn-secondary w-full py-2.5 text-center">
          Panduan Clone &amp; Instalasi Lokal
        </a>
      </div>
      <p class="border-t border-[#D8C8B5]/70 pt-4 text-center text-xs text-[#6C5E54]">
        <a href={creator.repoUrl} target="_blank" rel="noopener noreferrer"
          class="font-medium text-[#8B7561] underline underline-offset-4 hover:text-[#493D35]">
          Buka Repositori GitHub &rarr;
        </a>
      </p>
    </div>
  ) : (
    <form method="POST" class="space-y-5">
      {error && <p class="feedback-error">{error}</p>}

      <div>
        <label class="block text-sm font-medium text-[#493D35]" for="email">Email</label>
        <input id="email" name="email" type="email" value={email} required placeholder="nama@email.com"
          class="input-field mt-1.5" />
      </div>

      <div>
        <label class="block text-sm font-medium text-[#493D35]" for="password">Password</label>
        <input id="password" name="password" type="password" required placeholder="Masukkan password"
          class="input-field mt-1.5" />
      </div>

      <button class="btn-primary w-full py-2.5">Masuk</button>

      {canRegister && (
        <p class="border-t border-[#D8C8B5]/70 pt-4 text-center text-sm text-[#6C5E54]">
          Belum punya akun? <a href="/register" class="font-medium text-[#8B7561] underline underline-offset-4 hover:text-[#493D35]">Daftar</a>
        </p>
      )}
    </form>
  )}
</AuthLayout>