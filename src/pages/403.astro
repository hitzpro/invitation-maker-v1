---
import '../styles/global.css';
Astro.response.status = 403;
Astro.response.statusText = 'Forbidden';
---
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>403 · Akses Ditolak</title>
  </head>
  <body class="grid min-h-screen place-items-center bg-[#F5F0E8] px-6 text-[#493D35] antialiased">
    <main class="w-full max-w-md border-y border-[#D8C8B5] py-12 text-center">
      <p class="text-xs uppercase tracking-[0.2em] text-[#6C5E54]">Akses Terbatas</p>
      <h1 class="font-display mt-3 text-6xl font-medium tracking-tight text-[#493D35]">403</h1>
      <p class="mt-4 text-sm leading-relaxed text-[#6C5E54]">
        Anda tidak memiliki izin untuk membuka halaman atau sumber daya ini.
      </p>
      <div class="mt-7 flex items-center justify-center gap-3">
        <a href="/dashboard" class="btn-primary">Kembali ke Dashboard</a>
        <a href="/" class="btn-secondary">Beranda</a>
      </div>
    </main>
  </body>
</html>