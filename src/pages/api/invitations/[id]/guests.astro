---
import AppLayout from '../../../../layouts/AppLayout.astro';
import { and, desc, eq } from 'drizzle-orm';
import { db } from '../../../../db/index.js';
import { guestMessages, rsvps } from '../../../../db/schema.js';
import { getOwnedInvitation, isUuid } from '../../../../lib/invitations.js';

const user = Astro.locals.user;
const { id } = Astro.params;

const inv = await getOwnedInvitation(id, user.id);
if (!inv) return Astro.rewrite('/404');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') ?? '');
  const entryId = String(form.get('entryId') ?? '');

  if (isUuid(entryId)) {
    if (action === 'delete-rsvp') {
      await db.delete(rsvps).where(and(eq(rsvps.id, entryId), eq(rsvps.invitationId, inv.id)));
      return Astro.redirect(`/dashboard/invitations/${id}/guests?deleted=rsvp`);
    }
    if (action === 'delete-wish') {
      await db.delete(guestMessages).where(and(eq(guestMessages.id, entryId), eq(guestMessages.invitationId, inv.id)));
      return Astro.redirect(`/dashboard/invitations/${id}/guests?deleted=wish`);
    }
  }
}

const [rsvpRows, wishRows] = await Promise.all([
  db.select().from(rsvps).where(eq(rsvps.invitationId, inv.id)).orderBy(desc(rsvps.createdAt)),
  db.select().from(guestMessages).where(eq(guestMessages.invitationId, inv.id)).orderBy(desc(guestMessages.createdAt)),
]);

const hadirRows = rsvpRows.filter((r) => r.attendance === 'hadir');
const tidakHadirCount = rsvpRows.filter((r) => r.attendance === 'tidak_hadir').length;
const raguCount = rsvpRows.filter((r) => r.attendance === 'ragu').length;
const totalGuestCount = hadirRows.reduce((sum, r) => sum + (r.guestCount || 0), 0);

const deleted = Astro.url.searchParams.get('deleted');
const fmt = new Intl.DateTimeFormat('id-ID', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Jakarta' });
const badge = {
  hadir: ['Hadir', 'bg-green-100 text-green-700'],
  tidak_hadir: ['Tidak hadir', 'bg-red-100 text-red-700'],
  ragu: ['Ragu', 'bg-amber-100 text-amber-700'],
};
---
<AppLayout title={`Tamu & Ucapan · ${inv.title}`}>
  <a href={`/dashboard/invitations/${inv.id}`} class="text-sm underline">← Kembali ke ringkasan</a>
  <div class="mt-2 flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold">RSVP &amp; Ucapan Tamu</h1>
      <p class="text-sm text-gray-600">{inv.title}</p>
    </div>
    <a href={`/api/invitations/${inv.id}/guests.csv`}
      class="rounded bg-black px-4 py-2 text-sm text-white hover:bg-gray-800">
      Ekspor CSV
    </a>
  </div>

  {deleted && (
    <p class="mt-4 rounded border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-700">
      Entri {deleted === 'rsvp' ? 'RSVP' : 'ucapan'} berhasil dihapus.
    </p>
  )}

  <section class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
    <div class="rounded-lg border bg-white p-4">
      <p class="text-xs text-gray-600">Hadir</p>
      <p class="text-2xl font-bold">{hadirRows.length}</p>
    </div>
    <div class="rounded-lg border bg-white p-4">
      <p class="text-xs text-gray-600">Tidak hadir / Ragu</p>
      <p class="text-2xl font-bold">{tidakHadirCount} <span class="text-sm font-normal text-gray-500">/ {raguCount}</span></p>
    </div>
    <div class="rounded-lg border bg-white p-4">
      <p class="text-xs text-gray-600">Total tamu hadir</p>
      <p class="text-2xl font-bold">{totalGuestCount}</p>
    </div>
    <div class="rounded-lg border bg-white p-4">
      <p class="text-xs text-gray-600">Total ucapan</p>
      <p class="text-2xl font-bold">{wishRows.length}</p>
    </div>
  </section>

  <section class="mt-8 rounded-lg border bg-white p-6">
    <h2 class="font-semibold">Daftar Konfirmasi Kehadiran ({rsvpRows.length})</h2>
    {rsvpRows.length === 0 ? (
      <p class="mt-3 text-sm text-gray-500">Belum ada tamu yang mengisi RSVP.</p>
    ) : (
      <ul class="mt-4 divide-y">
        {rsvpRows.map((r) => {
          const [label, cls] = badge[r.attendance] ?? [r.attendance, 'bg-gray-100 text-gray-700'];
          return (
            <li class="flex flex-wrap items-center justify-between gap-3 py-3 text-sm">
              <div>
                <p class="font-medium">{r.guestName}</p>
                <p class="text-xs text-gray-500">{fmt.format(r.createdAt)}</p>
              </div>
              <div class="flex items-center gap-3">
                <span class={`rounded px-2 py-0.5 text-xs ${cls}`}>{label}</span>
                {r.attendance === 'hadir' && <span class="text-xs text-gray-600">{r.guestCount} orang</span>}
                <form method="POST" onsubmit="return confirm('Hapus data RSVP ini?')">
                  <input type="hidden" name="_action" value="delete-rsvp" />
                  <input type="hidden" name="entryId" value={r.id} />
                  <button class="text-xs text-red-600 underline">Hapus</button>
                </form>
              </div>
            </li>
          );
        })}
      </ul>
    )}
  </section>

  <section class="mt-6 rounded-lg border bg-white p-6">
    <h2 class="font-semibold">Ucapan &amp; Doa Tamu ({wishRows.length})</h2>
    {wishRows.length === 0 ? (
      <p class="mt-3 text-sm text-gray-500">Belum ada ucapan dari tamu.</p>
    ) : (
      <ul class="mt-4 divide-y">
        {wishRows.map((w) => (
          <li class="flex items-start justify-between gap-4 py-3 text-sm">
            <div class="min-w-0">
              <p class="font-medium">{w.guestName} <span class="ml-2 text-xs font-normal text-gray-500">{fmt.format(w.createdAt)}</span></p>
              <p class="mt-1 whitespace-pre-line text-gray-700">{w.message}</p>
            </div>
            <form method="POST" onsubmit="return confirm('Hapus ucapan ini?')" class="shrink-0">
              <input type="hidden" name="_action" value="delete-wish" />
              <input type="hidden" name="entryId" value={w.id} />
              <button class="text-xs text-red-600 underline">Hapus</button>
            </form>
          </li>
        ))}
      </ul>
    )}
  </section>
</AppLayout>