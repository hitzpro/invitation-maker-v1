---
import '../styles/global.css';
import { z } from 'zod';
import { eq } from 'drizzle-orm';
import { db } from '../db/index.js';
import { users } from '../db/schema.js';
import { hashPassword } from '../lib/password.js';
import { createSession, setSessionCookie } from '../lib/session.js';
import { isRegistrationAllowed } from '../lib/settings.js';

if (Astro.locals.user) return Astro.redirect('/dashboard');

const registrationOpen = await isRegistrationAllowed();
if (!registrationOpen && Astro.request.method === 'POST') {
  return new Response('Pendaftaran sedang ditutup', { status: 403 });
}

const schema = z.object({
  name: z.string().trim().min(2, 'Nama minimal 2 karakter').max(100, 'Nama maksimal 100 karakter'),
  email: z.string().trim().toLowerCase().email('Format email tidak valid'),
  password: z.string().min(8, 'Password minimal 8 karakter').max(128, 'Password maksimal 128 karakter'),
});

let errors = {};
let values = { name: '', email: '' };

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const input = {
    name: String(form.get('name') ?? ''),
    email: String(form.get('email') ?? ''),
    password: String(form.get('password') ?? ''),
  };
  values = { name: input.name, email: input.email };

  const parsed = schema.safeParse(input);
  if (!parsed.success) {
    for (const issue of parsed.error.issues) {
      (errors[issue.path[0]] ??= []).push(issue.message);
    }
  } else {
    const { name, email, password } = parsed.data;
    const [exists] = await db.select({ id: users.id }).from(users).where(eq(users.email, email)).limit(1);

    if (exists) {
      errors.email = ['Email sudah terdaftar'];
    } else {
      const [user] = await db
        .insert(users)
        .values({ name, email, passwordHash: await hashPassword(password) })
        .returning({ id: users.id });

      const { token, expiresAt } = await createSession(user.id);
      setSessionCookie(Astro.cookies, token, expiresAt);
      return Astro.redirect('/dashboard');
    }
  }
}
---
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Daftar</title>
  </head>
  <body class="min-h-screen grid place-items-center bg-gray-50 p-4">
    {!registrationOpen ? (
      <div class="w-full max-w-sm bg-white p-6 rounded-xl shadow space-y-3 text-center">
        <h1 class="text-xl font-bold">Pendaftaran Ditutup</h1>
        <p class="text-sm text-gray-600">Registrasi akun baru sedang dinonaktifkan oleh administrator.</p>
        <a href="/login" class="inline-block text-sm underline">Kembali ke halaman masuk</a>
      </div>
    ) : (
      <form method="POST" class="w-full max-w-sm bg-white p-6 rounded-xl shadow space-y-4">
        <h1 class="text-2xl font-bold">Daftar</h1>

        <div>
          <label class="block text-sm font-medium" for="name">Nama</label>
          <input id="name" name="name" value={values.name} required class="mt-1 w-full border rounded px-3 py-2" />
          {errors.name && <p class="text-sm text-red-600 mt-1">{errors.name[0]}</p>}
        </div>

        <div>
          <label class="block text-sm font-medium" for="email">Email</label>
          <input id="email" name="email" type="email" value={values.email} required class="mt-1 w-full border rounded px-3 py-2" />
          {errors.email && <p class="text-sm text-red-600 mt-1">{errors.email[0]}</p>}
        </div>

        <div>
          <label class="block text-sm font-medium" for="password">Password</label>
          <input id="password" name="password" type="password" required class="mt-1 w-full border rounded px-3 py-2" />
          {errors.password && <p class="text-sm text-red-600 mt-1">{errors.password[0]}</p>}
        </div>

        <button class="w-full bg-black text-white rounded py-2">Daftar</button>
        <p class="text-sm text-center">Sudah punya akun? <a href="/login" class="underline">Masuk</a></p>
      </form>
    )}
  </body>
</html>