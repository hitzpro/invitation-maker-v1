---
import AppLayout from '../../../layouts/AppLayout.astro';
import { z } from 'zod';
import { createInvitation } from '../../../lib/invitations.js';

const user = Astro.locals.user;

const schema = z.object({
  title: z.string().trim().min(3, 'Judul minimal 3 karakter').max(120, 'Judul maksimal 120 karakter'),
  method: z.enum(['automatic', 'manual'], { message: 'Pilih metode pembuatan' }),
});

let errors = {};
let values = { title: '', method: 'automatic' };

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const input = {
    title: String(form.get('title') ?? ''),
    method: String(form.get('method') ?? ''),
  };
  values = input;

  const parsed = schema.safeParse(input);
  if (!parsed.success) {
    for (const issue of parsed.error.issues) {
      (errors[issue.path[0]] ??= []).push(issue.message);
    }
  } else {
    const inv = await createInvitation(user.id, parsed.data);
    return Astro.redirect(`/dashboard/invitations/${inv.id}`);
  }
}
---
<AppLayout title="Buat Undangan Baru" activeNav="new">
  <div class="border-b border-[#D8C8B5] pb-6">
    <a href="/dashboard" class="text-xs font-medium text-[#6C5E54] underline underline-offset-4 hover:text-[#493D35]">
      Kembali ke Dashboard
    </a>
    <h1 class="font-display mt-2 text-3xl font-medium tracking-tight text-[#493D35]">Buat Undangan Baru</h1>
    <p class="mt-1 text-sm text-[#6C5E54]">
      Tentukan judul undangan dan pilih cara penyusunan yang paling sesuai dengan kebutuhan Anda.
    </p>
  </div>

  <form method="POST" class="surface-panel mt-8 max-w-2xl space-y-6 p-6 sm:p-8">
    <div>
      <label for="title" class="block text-sm font-medium text-[#493D35]">Judul undangan</label>
      <input id="title" name="title" value={values.title} required maxlength="120"
        placeholder="Contoh: Pernikahan Andi &amp; Sarah"
        class="input-field mt-1.5" />
      {errors.title && <p class="mt-1.5 text-sm text-[#A34E4E]">{errors.title[0]}</p>}
    </div>

    <fieldset>
      <legend class="block text-sm font-medium text-[#493D35]">Metode pembuatan</legend>
      <div class="mt-2.5 grid gap-4 sm:grid-cols-2">
        <label class="cursor-pointer rounded-[12px] border border-[#D8C8B5] bg-[#FFFFFF] p-4 transition-colors hover:border-[#8B7561] has-[:checked]:border-[#8B7561] has-[:checked]:bg-[#F5F0E8]/65">
          <div class="flex items-center gap-2.5">
            <input type="radio" name="method" value="automatic" checked={values.method === 'automatic'}
              class="accent-[#8B7561]" />
            <span class="text-sm font-medium text-[#493D35]">Formulir Otomatis</span>
          </div>
          <span class="mt-2 block text-xs leading-relaxed text-[#6C5E54]">
            Isi formulir bertahap untuk data mempelai, acara, cerita, dan foto. Sistem menyusun tata letak secara otomatis.
          </span>
        </label>

        <label class="cursor-pointer rounded-[12px] border border-[#D8C8B5] bg-[#FFFFFF] p-4 transition-colors hover:border-[#8B7561] has-[:checked]:border-[#8B7561] has-[:checked]:bg-[#F5F0E8]/65">
          <div class="flex items-center gap-2.5">
            <input type="radio" name="method" value="manual" checked={values.method === 'manual'}
              class="accent-[#8B7561]" />
            <span class="text-sm font-medium text-[#493D35]">Editor Visual Manual</span>
          </div>
          <span class="mt-2 block text-xs leading-relaxed text-[#6C5E54]">
            Atur warna utama, tipografi, urutan section, ornamen, musik latar, serta galeri secara langsung dengan live preview.
          </span>
        </label>
      </div>
      {errors.method && <p class="mt-1.5 text-sm text-[#A34E4E]">{errors.method[0]}</p>}
    </fieldset>

    <div class="flex flex-wrap items-center gap-3 border-t border-[#D8C8B5]/80 pt-5">
      <button class="btn-primary">Buat Undangan</button>
      <a href="/dashboard" class="btn-secondary">Batal</a>
    </div>
  </form>
</AppLayout>