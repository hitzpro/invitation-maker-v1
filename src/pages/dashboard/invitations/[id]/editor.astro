---
import '../../../../styles/global.css';
import { getOwnedInvitation, listAssets } from '../../../../lib/invitations.js';
import { SECTION_ORDER, getContentWithVersion } from '../../../../lib/content.js';
import { SECTION_LABELS } from '../../../../lib/render-data.js';
import ThemeFields from '../../../../components/editor/ThemeFields.astro';
import CoverFields from '../../../../components/editor/CoverFields.astro';
import CoupleFields from '../../../../components/editor/CoupleFields.astro';
import EventFields from '../../../../components/editor/EventFields.astro';
import StoryFields from '../../../../components/editor/StoryFields.astro';
import GalleryFields from '../../../../components/editor/GalleryFields.astro';
import LocationFields from '../../../../components/editor/LocationFields.astro';
import ClosingFields from '../../../../components/editor/ClosingFields.astro';
import '../../../../styles/patterns.css';
import StyleFields from '../../../../components/editor/StyleFields.astro';
import FontFields from '../../../../components/editor/FontFields.astro';
import DecorationFields from '../../../../components/editor/DecorationFields.astro';
import MusicFields from '../../../../components/editor/MusicFields.astro';

const user = Astro.locals.user;
const { id } = Astro.params;

const inv = await getOwnedInvitation(id, user.id);
if (!inv) return Astro.rewrite('/404');
if (inv.method !== 'manual') return Astro.redirect(`/dashboard/invitations/${id}`);

Astro.response.headers.set('Cache-Control', 'private, no-store');

const { content, version } = await getContentWithVersion(inv.id);
const assets = await listAssets(inv.id);
const tracks = await listAssets(inv.id, 'audio');

const initial = {
  invitationId: inv.id,
  content,
  version,
  assets: assets.map((a) => ({ id: a.id, name: a.originalName, thumb: `/uploads/${a.filename}?w=480` })),
  audio: tracks.map((a) => ({ id: a.id, name: a.originalName, url: `/audio/${a.filename}` })),
};
// '<' di-escape agar isi JSON tidak bisa menutup tag <script>
const initialJson = JSON.stringify(initial).replace(/</g, '\\u003c');

const fieldComponents = {
  cover: CoverFields,
  couple: CoupleFields,
  event: EventFields,
  story: StoryFields,
  gallery: GalleryFields,
  location: LocationFields,
  closing: ClosingFields,
};
const notes = {
  countdown: 'Tidak ada isian teks. Hitung mundur otomatis mengikuti acara pertama yang bertanggal.',
  rsvp: 'Tidak ada isian teks. Fungsi RSVP dikerjakan di fase berikutnya.',
  wishes: 'Tidak ada isian teks. Fungsi ucapan tamu dikerjakan di fase berikutnya.',
};

const cards = content.sectionOrder.map((key) => ({
  key,
  label: SECTION_LABELS[key],
  Fields: fieldComponents[key] ?? null,
  note: notes[key] ?? '',
  pinned: key === 'cover',
}));
---
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Editor · {inv.title}</title>
  </head>
  <body class="flex h-screen flex-col bg-gray-50 text-gray-900">
    <header class="flex h-12 shrink-0 items-center justify-between gap-3 border-b bg-white px-4">
      <div class="flex min-w-0 items-center gap-3">
        <a href={`/dashboard/invitations/${id}`} class="shrink-0 text-sm underline">← Kelola</a>
        <span class="truncate font-medium">{inv.title}</span>
      </div>
      <div class="flex shrink-0 items-center gap-3 text-sm">
        <span id="save-status" class="text-green-700" aria-live="polite">Tersimpan</span>
        <a href={`/dashboard/invitations/${id}/preview`} target="_blank" rel="noopener"
          class="rounded border px-3 py-1 hover:bg-gray-100">Buka preview ↗</a>
      </div>
    </header>

    <div id="conflict-banner" class="hidden shrink-0 border-b border-red-200 bg-red-50 px-4 py-2 text-sm text-red-700">
      Konten undangan ini berubah di tempat lain (tab lain atau perangkat lain), jadi penyimpanan dihentikan agar tidak saling menimpa.
      <button id="reload-btn" type="button" class="ml-2 underline">Muat ulang editor</button>
    </div>

    <div class="flex shrink-0 border-b bg-white text-sm lg:hidden">
      <button type="button" data-tab="edit" class="flex-1 border-b-2 border-black py-2 font-medium">Edit</button>
      <button type="button" data-tab="preview" class="flex-1 py-2">Preview</button>
    </div>

    <main class="min-h-0 flex-1 lg:grid lg:grid-cols-[minmax(340px,440px)_1fr] lg:grid-rows-[minmax(0,1fr)]">
      <aside id="pane-edit" class="h-full overflow-y-auto border-r bg-white p-4 lg:block">
        <ul id="error-summary" class="mb-3 hidden list-disc space-y-1 rounded border border-red-200 bg-red-50 p-3 pl-6 text-sm text-red-700"></ul>

        <details class="mb-4 rounded-lg border" data-theme-card>
          <summary class="cursor-pointer select-none px-4 py-3 font-medium">Tema dan warna</summary>
          <div class="space-y-3 border-t px-4 py-4"><ThemeFields /></div>
        </details>

        <details class="mb-4 rounded-lg border">
          <summary class="cursor-pointer select-none px-4 py-3 font-medium">Hiasan dekoratif</summary>
          <div class="space-y-3 border-t px-4 py-4"><DecorationFields /></div>
        </details>

        <details class="mb-4 rounded-lg border">
          <summary class="cursor-pointer select-none px-4 py-3 font-medium">Musik</summary>
          <div class="space-y-3 border-t px-4 py-4"><MusicFields /></div>
        </details>

        <div class="mb-2 flex items-center justify-between gap-2">
          <p class="text-xs text-gray-500">Atur urutan dengan ↑ ↓ dan sembunyikan section lewat kotak "Tampil". Cover selalu di atas.</p>
          <button type="button" id="reset-order" class="shrink-0 rounded border px-2 py-1 text-xs hover:bg-gray-50">Reset urutan</button>
        </div>

        <div class="space-y-3" id="sections" data-default-order={JSON.stringify(SECTION_ORDER)}>
          {cards.map(({ key, label, Fields, note, pinned }) => (
            <div class="rounded-lg border" data-section={key}>
              <div class="flex items-center gap-1 px-2 py-2">
                <button type="button" data-card-toggle aria-expanded={pinned ? 'true' : 'false'}
                  class="flex-1 px-2 py-1 text-left font-medium">
                  <span data-card-title>{label}</span>
                  <span data-badge-off class="ml-2 hidden rounded bg-gray-200 px-1.5 py-0.5 text-xs font-normal text-gray-600">Nonaktif</span>
                </button>
                {pinned ? (
                  <span class="px-1 text-xs text-gray-400">Selalu di atas</span>
                ) : (
                  <>
                    <button type="button" data-move-up aria-label={`Naikkan ${label}`}
                      class="h-8 w-8 rounded border text-sm hover:bg-gray-50 disabled:opacity-30">↑</button>
                    <button type="button" data-move-down aria-label={`Turunkan ${label}`}
                      class="h-8 w-8 rounded border text-sm hover:bg-gray-50 disabled:opacity-30">↓</button>
                  </>
                )}
                <label class="flex items-center gap-1.5 pl-2 text-xs">
                  <input type="checkbox" data-enabled data-bind={`sections.${key}.enabled`} />
                  Tampil
                </label>
              </div>
              <div data-card-body class={'space-y-3 border-t px-4 py-4 ' + (pinned ? '' : 'hidden')}>
                {Fields ? <Fields /> : <p class="text-sm text-gray-500">{note}</p>}
                {!pinned && <StyleFields sectionKey={key} />}
                <FontFields sectionKey={key} />
              </div>
            </div>
          ))}
        </div>
      </aside>

      <section id="pane-preview" class="hidden h-full bg-stone-300 lg:block">
        <div class="flex h-full flex-col">
          <div class="flex shrink-0 items-center justify-between gap-2 border-b bg-white px-3 py-1.5 text-xs">
            <span id="preview-status" class="text-gray-500" aria-live="polite"></span>
            <div class="flex gap-1" role="group" aria-label="Lebar preview">
              <button type="button" data-device="full" class="rounded border px-2 py-1">Penuh</button>
              <button type="button" data-device="tablet" class="rounded border px-2 py-1">Tablet</button>
              <button type="button" data-device="phone" class="rounded border px-2 py-1">Ponsel</button>
            </div>
          </div>

          <div class="relative min-h-0 flex-1 overflow-hidden">
            <div id="frame-wrap" class="relative mx-auto h-full max-w-full bg-white transition-[width] duration-200">
              <iframe data-frame title="Preview undangan" class="absolute inset-0 h-full w-full border-0 bg-white"></iframe>
              <iframe data-frame title="Preview undangan (cadangan)" aria-hidden="true" tabindex="-1"
                class="pointer-events-none absolute inset-0 h-full w-full border-0 bg-white opacity-0"></iframe>
            </div>
          </div>
        </div>
      </section>
    </main>

    <dialog id="photo-picker" class="m-auto w-[min(92vw,640px)] rounded-lg border-0 p-0 backdrop:bg-black/60">
      <div class="flex max-h-[85vh] flex-col">
        <div class="flex items-center justify-between border-b px-4 py-3">
          <h2 class="font-semibold" data-picker-title>Pilih foto</h2>
          <button type="button" data-picker-cancel class="text-xl leading-none" aria-label="Tutup">✕</button>
        </div>
        <div class="overflow-y-auto p-4">
          <p data-picker-empty class="hidden text-sm text-gray-500">Belum ada foto. Unggah foto baru di bawah.</p>
          <div data-picker-grid class="grid grid-cols-3 gap-2 sm:grid-cols-4"></div>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3 border-t px-4 py-3">
          <div>
            <label class="inline-block cursor-pointer rounded border px-3 py-1.5 text-sm hover:bg-gray-50">
              Unggah foto baru
              <input type="file" accept="image/jpeg,image/png" multiple class="hidden" data-picker-upload />
            </label>
            <p data-picker-msg class="mt-1 text-xs text-red-600"></p>
          </div>
          <button type="button" data-picker-confirm
            class="hidden rounded bg-black px-4 py-1.5 text-sm text-white disabled:opacity-40">Tambahkan</button>
        </div>
      </div>
    </dialog>

    <script type="application/json" id="editor-data" set:html={initialJson} />
    <script>
      import '../../../../scripts/editor.js';
    </script>
  </body>
</html>