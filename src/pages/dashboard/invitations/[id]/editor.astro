---
import '../../../../styles/global.css';
import '../../../../styles/patterns.css';
import { getOwnedInvitation, listAssets } from '../../../../lib/invitations.js';
import { SECTION_ORDER, getContentWithVersion } from '../../../../lib/content.js';
import { SECTION_LABELS } from '../../../../lib/render-data.js';
import ThemeFields from '../../../../components/editor/ThemeFields.astro';
import CoverFields from '../../../../components/editor/CoverFields.astro';
import CoupleFields from '../../../../components/editor/CoupleFields.astro';
import EventFields from '../../../../components/editor/EventFields.astro';
import StoryFields from '../../../../components/editor/StoryFields.astro';
import GalleryFields from '../../../../components/editor/GalleryFields.astro';
import LocationFields from '../../../../components/editor/LocationFields.astro';
import ClosingFields from '../../../../components/editor/ClosingFields.astro';
import StyleFields from '../../../../components/editor/StyleFields.astro';
import FontFields from '../../../../components/editor/FontFields.astro';
import DecorationFields from '../../../../components/editor/DecorationFields.astro';
import MusicFields from '../../../../components/editor/MusicFields.astro';
import GiftFields from '../../../../components/editor/GiftFields.astro';

const user = Astro.locals.user;
const { id } = Astro.params;

const inv = await getOwnedInvitation(id, user.id);
if (!inv) return Astro.rewrite('/404');
if (inv.method !== 'manual') return Astro.redirect(`/dashboard/invitations/${id}`);

Astro.response.headers.set('Cache-Control', 'private, no-store');

const { content, version } = await getContentWithVersion(inv.id);
const assets = await listAssets(inv.id);
const tracks = await listAssets(inv.id, 'audio');
const svgs = await listAssets(inv.id, 'svg');

const initial = {
  invitationId: inv.id,
  content,
  version,
  assets: assets.map((a) => ({ id: a.id, name: a.originalName, thumb: `/uploads/${a.filename}?w=480` })),
  audio: tracks.map((a) => ({ id: a.id, name: a.originalName, url: `/audio/${a.filename}` })),
  svgs: svgs.map((a) => ({ id: a.id, name: a.originalName })),
};
const initialJson = JSON.stringify(initial).replace(/</g, '\\u003c');

const fieldComponents = {
  cover: CoverFields,
  couple: CoupleFields,
  event: EventFields,
  story: StoryFields,
  gallery: GalleryFields,
  location: LocationFields,
  gift: GiftFields,
  closing: ClosingFields,
};
const notes = {
  countdown: 'Hitung mundur otomatis mengikuti acara pertama yang memiliki tanggal valid.',
  rsvp: 'Formulir konfirmasi kehadiran tamu aktif secara otomatis setelah undangan dipublikasikan.',
  wishes: 'Kolom doa dan ucapan tamu aktif secara otomatis setelah undangan dipublikasikan.',
};

const cards = content.sectionOrder.map((key) => ({
  key,
  label: SECTION_LABELS[key],
  Fields: fieldComponents[key] ?? null,
  note: notes[key] ?? '',
  pinned: key === 'cover',
}));
---
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Editor Visual · {inv.title}</title>
  </head>
  <body class="flex h-screen flex-col overflow-hidden bg-[#F5F0E8] text-[#493D35]">
    <!-- Top Workspace Toolbar -->
    <header class="flex h-14 shrink-0 items-center justify-between gap-4 border-b border-[#D8C8B5] bg-[#FFFFFF] px-4 sm:px-6">
      <div class="flex min-w-0 items-center gap-3">
        <a href={`/dashboard/invitations/${id}`} class="btn-secondary shrink-0 px-3 py-1.5 text-xs">
          Kembali
        </a>
        <div class="min-w-0">
          <p class="truncate text-sm font-medium text-[#493D35]">{inv.title}</p>
          <p class="hidden text-[11px] text-[#6C5E54] sm:block">Editor Visual</p>
        </div>
      </div>

      <div class="flex shrink-0 items-center gap-2.5 text-xs">
        <div class="hidden items-center gap-1.5 sm:flex">
          <button type="button" id="undo-btn" title="Urungkan (Ctrl+Z)" disabled
            class="btn-secondary px-2.5 py-1.5 text-xs">
            Urungkan
          </button>
          <button type="button" id="redo-btn" title="Ulangi (Ctrl+Y)" disabled
            class="btn-secondary px-2.5 py-1.5 text-xs">
            Ulangi
          </button>
        </div>

        <span id="save-status" class="font-medium text-[#58765D]" aria-live="polite">Tersimpan</span>

        <a href={`/dashboard/invitations/${id}/preview`} target="_blank" rel="noopener"
          class="btn-primary px-3 py-1.5 text-xs">
          Buka Preview
        </a>
      </div>
    </header>

    <div id="conflict-banner" class="hidden shrink-0 border-b border-[#E8C5C5] bg-[#FBF2F2] px-4 py-2 text-xs text-[#A34E4E]">
      Konten undangan ini berubah di tab atau perangkat lain, sehingga penyimpanan otomatis dihentikan agar tidak menimpa data.
      <button id="reload-btn" type="button" class="ml-2 font-medium underline">Muat Ulang Editor</button>
    </div>

    <!-- Mobile 3-Tab Switcher -->
    <div class="grid shrink-0 grid-cols-3 border-b border-[#D8C8B5] bg-[#FFFFFF] text-xs lg:hidden">
      <button type="button" data-tab="structure"
        class="border-b-2 border-[#8B7561] py-2.5 font-medium text-[#493D35]">
        Struktur
      </button>
      <button type="button" data-tab="properties"
        class="border-b-2 border-transparent py-2.5 text-[#6C5E54]">
        Properti
      </button>
      <button type="button" data-tab="preview"
        class="border-b-2 border-transparent py-2.5 text-[#6C5E54]">
        Preview
      </button>
    </div>

    <!-- 3-Panel Desktop Workspace -->
    <main class="min-h-0 flex-1 lg:grid lg:grid-cols-[260px_minmax(0,1fr)_370px] lg:grid-rows-[minmax(0,1fr)]">
      <!-- LEFT PANEL: Global Settings & Section Structure -->
      <aside id="pane-structure" class="h-full overflow-y-auto border-r border-[#D8C8B5] bg-[#FFFFFF] p-4 lg:block">
        <div class="space-y-1.5">
          <p class="px-1 text-[11px] font-medium uppercase tracking-[0.14em] text-[#6C5E54]">Pengaturan Global</p>
          <button type="button" data-panel-pick="global-theme"
            class="w-full rounded-[9px] border border-[#8B7561] bg-[#F5F0E8] px-3 py-2 text-left text-xs font-medium text-[#493D35] transition-colors">
            Tema &amp; Warna
          </button>
          <button type="button" data-panel-pick="global-decorations"
            class="w-full rounded-[9px] border border-[#D8C8B5] bg-[#FFFFFF] px-3 py-2 text-left text-xs font-medium text-[#493D35] transition-colors hover:bg-[#F5F0E8]/60">
            Hiasan Dekoratif
          </button>
          <button type="button" data-panel-pick="global-music"
            class="w-full rounded-[9px] border border-[#D8C8B5] bg-[#FFFFFF] px-3 py-2 text-left text-xs font-medium text-[#493D35] transition-colors hover:bg-[#F5F0E8]/60">
            Musik Latar
          </button>
        </div>

        <div class="mt-6 border-t border-[#D8C8B5] pt-4">
          <div class="mb-3 flex items-center justify-between gap-2 px-1">
            <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-[#6C5E54]">Struktur Section</p>
            <button type="button" id="reset-order"
              class="text-[11px] font-medium text-[#8B7561] underline underline-offset-4 hover:text-[#735F4D]">
              Reset Urutan
            </button>
          </div>

          <div class="space-y-2" id="sections" data-default-order={JSON.stringify(SECTION_ORDER)}>
            {cards.map(({ key, label, pinned }) => (
              <div class="rounded-[10px] border border-[#D8C8B5] bg-[#FFFFFF] p-2.5 transition-colors" data-section={key}>
                <div class="flex items-center justify-between gap-2">
                  <button type="button" data-card-toggle aria-expanded="false"
                    class="min-w-0 flex-1 text-left text-xs font-medium text-[#493D35]">
                    <span data-card-title class="block truncate">{label}</span>
                    <span class="mt-1 flex flex-wrap items-center gap-1">
                      <span data-badge-off class="hidden rounded-[5px] border border-[#D8C8B5] bg-[#F5F0E8] px-1.5 py-0.5 text-[10px] font-normal text-[#6C5E54]">
                        Nonaktif
                      </span>
                      <span data-badge-empty class="hidden rounded-[5px] border border-[#E6D5B8] bg-[#FDF8EF] px-1.5 py-0.5 text-[10px] font-normal text-[#B17C42]">
                        Belum diisi
                      </span>
                    </span>
                  </button>

                  <label class="flex shrink-0 items-center gap-1.5 text-[11px] text-[#6C5E54]">
                    <input type="checkbox" data-enabled data-bind={`sections.${key}.enabled`} class="accent-[#8B7561]" />
                    Tampil
                  </label>
                </div>

                <div class="mt-2 flex items-center justify-between gap-2 border-t border-[#D8C8B5]/60 pt-2">
                  {pinned ? (
                    <span class="text-[11px] text-[#6C5E54]">Posisi tetap di atas</span>
                  ) : (
                    <div class="flex items-center gap-1.5">
                      <button type="button" data-move-up aria-label={`Naikkan ${label}`}
                        class="rounded-[6px] border border-[#D8C8B5] bg-[#FFFFFF] px-2 py-0.5 text-[11px] text-[#493D35] hover:bg-[#F5F0E8] disabled:opacity-35">
                        Naik
                      </button>
                      <button type="button" data-move-down aria-label={`Turunkan ${label}`}
                        class="rounded-[6px] border border-[#D8C8B5] bg-[#FFFFFF] px-2 py-0.5 text-[11px] text-[#493D35] hover:bg-[#F5F0E8] disabled:opacity-35">
                        Turun
                      </button>
                    </div>
                  )}
                  <button type="button" data-open-prop={key}
                    class="text-[11px] font-medium text-[#8B7561] underline underline-offset-4 hover:text-[#735F4D]">
                    Ubah
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>
      </aside>

      <!-- CENTER PANEL: Live Preview Canvas -->
      <section id="pane-preview" class="hidden h-full bg-[#EAE3D7] lg:block">
        <div class="flex h-full flex-col">
          <div class="flex shrink-0 items-center justify-between gap-2 border-b border-[#D8C8B5] bg-[#FFFFFF] px-4 py-2 text-xs">
            <span id="preview-status" class="text-[#6C5E54]" aria-live="polite"></span>
            <div class="flex items-center gap-1" role="group" aria-label="Lebar preview">
              <button type="button" data-device="full"
                class="rounded-[6px] border border-[#D8C8B5] px-2.5 py-1 text-xs">Penuh</button>
              <button type="button" data-device="tablet"
                class="rounded-[6px] border border-[#D8C8B5] px-2.5 py-1 text-xs">Tablet</button>
              <button type="button" data-device="phone"
                class="rounded-[6px] border border-[#D8C8B5] px-2.5 py-1 text-xs">Ponsel</button>
            </div>
          </div>

          <div class="relative min-h-0 flex-1 overflow-hidden p-0 sm:p-3">
            <div id="frame-wrap" class="relative mx-auto h-full max-w-full overflow-hidden rounded-none border border-[#D8C8B5]/80 bg-[#FFFFFF] transition-[width] duration-200 sm:rounded-[10px]">
              <iframe data-frame title="Preview undangan" class="absolute inset-0 h-full w-full border-0 bg-[#FFFFFF]"></iframe>
              <iframe data-frame title="Preview undangan (cadangan)" aria-hidden="true" tabindex="-1"
                class="pointer-events-none absolute inset-0 h-full w-full border-0 bg-[#FFFFFF] opacity-0"></iframe>
            </div>
          </div>
        </div>
      </section>

      <!-- RIGHT PANEL: Active Properties Editor -->
      <aside id="pane-properties" class="hidden h-full overflow-y-auto border-l border-[#D8C8B5] bg-[#FFFFFF] p-5 lg:block">
        <ul id="error-summary" class="mb-4 hidden list-disc space-y-1 rounded-[9px] border border-[#E8C5C5] bg-[#FBF2F2] p-3 pl-6 text-xs text-[#A34E4E]"></ul>

        <div data-prop-panel="global-theme" class="space-y-5">
          <div class="border-b border-[#D8C8B5] pb-3">
            <p class="text-[11px] uppercase tracking-[0.14em] text-[#6C5E54]">Pengaturan Global</p>
            <h2 class="font-display mt-0.5 text-xl font-medium text-[#493D35]">Tema &amp; Warna</h2>
          </div>
          <ThemeFields />
        </div>

        <div data-prop-panel="global-decorations" class="hidden space-y-5">
          <div class="border-b border-[#D8C8B5] pb-3">
            <p class="text-[11px] uppercase tracking-[0.14em] text-[#6C5E54]">Pengaturan Global</p>
            <h2 class="font-display mt-0.5 text-xl font-medium text-[#493D35]">Hiasan Dekoratif</h2>
          </div>
          <DecorationFields />
        </div>

        <div data-prop-panel="global-music" class="hidden space-y-5">
          <div class="border-b border-[#D8C8B5] pb-3">
            <p class="text-[11px] uppercase tracking-[0.14em] text-[#6C5E54]">Pengaturan Global</p>
            <h2 class="font-display mt-0.5 text-xl font-medium text-[#493D35]">Musik Latar</h2>
          </div>
          <MusicFields />
        </div>

        {cards.map(({ key, label, Fields, note, pinned }) => (
          <div data-prop-panel={key} class="hidden space-y-5">
            <div class="border-b border-[#D8C8B5] pb-3">
              <p class="text-[11px] uppercase tracking-[0.14em] text-[#6C5E54]">Properti Section</p>
              <h2 class="font-display mt-0.5 text-xl font-medium text-[#493D35]">{label}</h2>
            </div>
            {Fields ? <Fields /> : <p class="text-sm leading-relaxed text-[#6C5E54]">{note}</p>}
            {!pinned && <StyleFields sectionKey={key} />}
            <FontFields sectionKey={key} />
          </div>
        ))}
      </aside>
    </main>

    <!-- Shared Photo Picker Modal -->
    <dialog id="photo-picker" class="m-auto w-[min(92vw,640px)] rounded-[14px] border border-[#D8C8B5] bg-[#FFFFFF] p-0 text-[#493D35] backdrop:bg-[#493D35]/60">
      <div class="flex max-h-[85vh] flex-col">
        <div class="flex items-center justify-between border-b border-[#D8C8B5] px-5 py-3.5">
          <h2 class="font-display text-lg font-medium text-[#493D35]" data-picker-title>Pilih Foto</h2>
          <button type="button" data-picker-cancel class="btn-secondary px-3 py-1 text-xs">Tutup</button>
        </div>
        <div class="overflow-y-auto p-5">
          <p data-picker-empty class="hidden text-sm text-[#6C5E54]">
            Belum ada foto. Unggah foto baru menggunakan tombol di bawah.
          </p>
          <div data-picker-grid class="grid grid-cols-3 gap-2.5 sm:grid-cols-4"></div>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3 border-t border-[#D8C8B5] bg-[#F5F0E8]/50 px-5 py-3.5">
          <div>
            <label class="btn-secondary cursor-pointer px-3 py-1.5 text-xs">
              Unggah Foto Baru
              <input type="file" accept="image/jpeg,image/png" multiple class="hidden" data-picker-upload />
            </label>
            <p data-picker-msg class="mt-1 text-xs text-[#A34E4E]"></p>
          </div>
          <button type="button" data-picker-confirm class="btn-primary hidden px-4 py-1.5 text-xs">
            Tambahkan
          </button>
        </div>
      </div>
    </dialog>

    <script type="application/json" id="editor-data" set:html={initialJson} />
    <script>
      import '../../../../scripts/editor.js';
    </script>
  </body>
</html>