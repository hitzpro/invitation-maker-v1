---
import AppLayout from '../../../../layouts/AppLayout.astro';
import Field from '../../../../components/Field.astro';
import UploadBox from '../../../../components/UploadBox.astro';
import { getOwnedInvitation, listAssets } from '../../../../lib/invitations.js';
import { MAX_ASSETS_PER_INVITATION } from '../../../../lib/upload.js';
import {
  EVENT_SLOTS, PHOTO_ROLES, STORY_SLOTS, TIMEZONES,
  applyStep, getInvitationContent, toFormValues, updateInvitationContent, validateStep,
} from '../../../../lib/content.js';

const STEPS = [
  { n: 1, key: 'couple', label: 'Mempelai' },
  { n: 2, key: 'event', label: 'Acara' },
  { n: 3, key: 'story', label: 'Cerita & Penutup' },
  { n: 4, key: 'photos', label: 'Foto' },
];

const user = Astro.locals.user;
const { id } = Astro.params;

const inv = await getOwnedInvitation(id, user.id);
if (!inv) return Astro.rewrite('/404');
if (inv.method !== 'automatic') return Astro.redirect(`/dashboard/invitations/${id}`);

const requested = Number(Astro.url.searchParams.get('step') ?? 1);
const step = STEPS.find((s) => s.n === requested) ?? STEPS[0];
const isLast = step.n === STEPS.length;

const content = await getInvitationContent(inv.id);
const assets = step.key === 'photos' ? await listAssets(inv.id) : [];

let values = toFormValues(step.key, content);
let errors = {};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const raw = Object.fromEntries([...form.entries()].filter(([, v]) => typeof v === 'string'));
  values = raw;

  const result = validateStep(step.key, raw, { assetIds: assets.map((a) => a.id) });
  if (result.errors) {
    errors = result.errors;
  } else {
    await updateInvitationContent(inv.id, (c) => applyStep(step.key, c, result.data));
    return Astro.redirect(
      isLast
        ? `/dashboard/invitations/${id}?saved=form`
        : `/dashboard/invitations/${id}/form?step=${step.n + 1}`
    );
  }
}

const v = (name) => values[name] ?? '';
const e = (name) => errors[name] ?? '';
---
<AppLayout
  title={`Formulir · ${inv.title}`}
  invitationNav={{ id: inv.id, title: inv.title, method: inv.method, active: 'form' }}
>
  <div class="flex flex-wrap items-end justify-between gap-4 border-b border-[#D8C8B5] pb-6">
    <div>
      <a href={`/dashboard/invitations/${id}`} class="text-xs font-medium text-[#6C5E54] underline underline-offset-4 hover:text-[#493D35]">
        Kembali ke Ringkasan
      </a>
      <h1 class="font-display mt-2 text-3xl font-medium tracking-tight text-[#493D35]">Isi Data Undangan</h1>
      <p class="mt-1 text-sm text-[#6C5E54]">{inv.title} · Formulir Otomatis</p>
    </div>
    <a href={`/dashboard/invitations/${id}/preview`} target="_blank" rel="noopener" class="btn-secondary">
      Lihat Preview
    </a>
  </div>

  <!-- Horizontal Step Indicator -->
  <nav aria-label="Tahapan formulir" class="mt-6">
    <ol class="grid grid-cols-2 gap-2 sm:grid-cols-4">
      {STEPS.map((s) => {
        const isCurrent = s.n === step.n;
        const isDone = s.n < step.n;
        return (
          <li>
            <a href={`/dashboard/invitations/${id}/form?step=${s.n}`}
              aria-current={isCurrent ? 'step' : undefined}
              class={
                'flex items-center justify-between rounded-[10px] border px-3.5 py-2.5 text-sm transition-colors ' +
                (isCurrent
                  ? 'border-[#8B7561] bg-[#8B7561] font-medium text-white'
                  : isDone
                    ? 'border-[#8B7561]/60 bg-[#FFFFFF] text-[#493D35] hover:bg-[#F5F0E8]'
                    : 'border-[#D8C8B5] bg-[#FFFFFF] text-[#6C5E54] hover:border-[#8B7561] hover:text-[#493D35]')
              }>
              <span class="truncate">{s.n}. {s.label}</span>
              <span class={'ml-2 text-[11px] tabular-nums ' + (isCurrent ? 'text-white/85' : 'text-[#6C5E54]')}>
                {isCurrent ? 'Aktif' : isDone ? 'Selesai' : ''}
              </span>
            </a>
          </li>
        );
      })}
    </ol>
  </nav>

  {step.key === 'photos' && (
    <section class="surface-panel mt-6 max-w-3xl p-6 sm:p-7">
      <h2 class="font-display text-lg font-medium text-[#493D35]">Unggah Foto Undangan</h2>
      <p class="mt-1 mb-4 text-sm text-[#6C5E54]">
        Format JPEG atau PNG, maksimal 20 MB per file. Bisa memilih beberapa file sekaligus
        (<span class="tabular-nums">{assets.length}/{MAX_ASSETS_PER_INVITATION}</span> gambar).
        Unggah terlebih dahulu, lalu tentukan peran tiap foto di bawah.
      </p>
      <UploadBox invitationId={inv.id} />
    </section>
  )}

  <form method="POST" class="surface-panel mt-6 max-w-3xl space-y-8 p-6 sm:p-8">
    <div class="border-b border-[#D8C8B5]/80 pb-4">
      <p class="text-xs uppercase tracking-[0.14em] text-[#6C5E54]">Langkah {step.n} dari {STEPS.length}</p>
      <h2 class="font-display mt-1 text-xl font-medium text-[#493D35]">{step.label}</h2>
    </div>

    {errors._form && <p class="feedback-error">{errors._form}</p>}

    {step.key === 'couple' && (
      <div class="space-y-8">
        <Field name="intro" label="Kalimat pembuka (opsional)" rows="3" maxlength="500"
          value={v('intro')} error={e('intro')}
          hint="Misalnya ayat suci atau kutipan hangat yang ingin ditampilkan di awal bagian mempelai." />

        <fieldset class="space-y-4 border-t border-[#D8C8B5]/80 pt-6">
          <legend class="font-display text-base font-medium text-[#493D35]">Mempelai Wanita</legend>
          <div class="grid gap-4 sm:grid-cols-2">
            <Field name="bride_name" label="Nama panggilan" required maxlength="40" value={v('bride_name')} error={e('bride_name')} />
            <Field name="bride_fullName" label="Nama lengkap" required maxlength="100" value={v('bride_fullName')} error={e('bride_fullName')} />
          </div>
          <Field name="bride_parents" label="Putri dari (orang tua)" maxlength="200" value={v('bride_parents')} error={e('bride_parents')}
            placeholder="Bapak ... dan Ibu ..." />
        </fieldset>

        <fieldset class="space-y-4 border-t border-[#D8C8B5]/80 pt-6">
          <legend class="font-display text-base font-medium text-[#493D35]">Mempelai Pria</legend>
          <div class="grid gap-4 sm:grid-cols-2">
            <Field name="groom_name" label="Nama panggilan" required maxlength="40" value={v('groom_name')} error={e('groom_name')} />
            <Field name="groom_fullName" label="Nama lengkap" required maxlength="100" value={v('groom_fullName')} error={e('groom_fullName')} />
          </div>
          <Field name="groom_parents" label="Putra dari (orang tua)" maxlength="200" value={v('groom_parents')} error={e('groom_parents')}
            placeholder="Bapak ... dan Ibu ..." />
        </fieldset>
      </div>
    )}

    {step.key === 'event' && (
      <div class="space-y-8">
        <div class="max-w-xs">
          <label for="timezone" class="block text-sm font-medium text-[#493D35]">Zona waktu acara</label>
          <select id="timezone" name="timezone" class="input-field mt-1.5">
            {Object.entries(TIMEZONES).map(([tz, label]) => (
              <option value={tz} selected={v('timezone') === tz}>{label}</option>
            ))}
          </select>
          {e('timezone') && <p class="mt-1 text-sm text-[#A34E4E]">{e('timezone')}</p>}
        </div>

        {EVENT_SLOTS.map((slot) => (
          <fieldset class="space-y-4 border-t border-[#D8C8B5]/80 pt-6">
            <legend class="font-display text-base font-medium text-[#493D35]">{slot.label}</legend>
            <div class="grid gap-4 sm:grid-cols-3">
              <Field type="date" name={`${slot.key}_date`} label="Tanggal" value={v(`${slot.key}_date`)} error={e(`${slot.key}_date`)} />
              <Field type="time" name={`${slot.key}_startTime`} label="Jam mulai" value={v(`${slot.key}_startTime`)} error={e(`${slot.key}_startTime`)} />
              <Field type="time" name={`${slot.key}_endTime`} label="Jam selesai (opsional)" value={v(`${slot.key}_endTime`)} error={e(`${slot.key}_endTime`)} />
            </div>
            <Field name={`${slot.key}_venue`} label="Nama tempat" maxlength="120" value={v(`${slot.key}_venue`)} error={e(`${slot.key}_venue`)} />
            <Field name={`${slot.key}_address`} label="Alamat lengkap" rows="2" maxlength="300" value={v(`${slot.key}_address`)} error={e(`${slot.key}_address`)} />
            <p class="text-xs text-[#6C5E54]">Kosongkan seluruh isian jika acara ini tidak diadakan.</p>
          </fieldset>
        ))}

        <div class="border-t border-[#D8C8B5]/80 pt-6">
          <Field name="mapsUrl" type="url" label="Tautan Google Maps (opsional)" maxlength="500"
            value={v('mapsUrl')} error={e('mapsUrl')} placeholder="https://maps.app.goo.gl/..."
            hint="Lokasi di undangan mengikuti acara pertama yang Anda isi." />
        </div>
      </div>
    )}

    {step.key === 'story' && (
      <div class="space-y-8">
        <p class="text-sm text-[#6C5E54]">Kisah perjalanan bersifat opsional. Kosongkan jika tidak ingin menampilkannya.</p>
        {Array.from({ length: STORY_SLOTS }, (_, i) => i + 1).map((i) => (
          <fieldset class="space-y-4 border-t border-[#D8C8B5]/80 pt-6">
            <legend class="font-display text-base font-medium text-[#493D35]">Cerita {i}</legend>
            <div class="grid gap-4 sm:grid-cols-2">
              <Field name={`story${i}_title`} label="Judul" maxlength="80" value={v(`story${i}_title`)} error={e(`story${i}_title`)} placeholder="Pertemuan pertama" />
              <Field name={`story${i}_date`} label="Waktu" maxlength="40" value={v(`story${i}_date`)} error={e(`story${i}_date`)} placeholder="Mei 2019" />
            </div>
            <Field name={`story${i}_text`} label="Cerita" rows="3" maxlength="600" value={v(`story${i}_text`)} error={e(`story${i}_text`)} />
          </fieldset>
        ))}

        <div class="border-t border-[#D8C8B5]/80 pt-6">
          <Field name="closing" label="Pesan penutup (opsional)" rows="3" maxlength="600"
            value={v('closing')} error={e('closing')} />
        </div>
      </div>
    )}

    {step.key === 'photos' && (
      assets.length === 0 ? (
        <p class="text-sm text-[#6C5E54]">
          Belum ada foto. Unggah dulu lewat kotak di atas, atau langsung selesaikan formulir tanpa foto.
        </p>
      ) : (
        <div class="space-y-4">
          <p class="text-sm text-[#6C5E54]">
            Cover, foto mempelai wanita, dan foto mempelai pria masing-masing hanya dapat memilih satu gambar.
            Gambar dengan peran &ldquo;Galeri&rdquo; tampil sesuai urutan unggah.
          </p>
          <ul class="grid gap-4 sm:grid-cols-2">
            {assets.map((a) => (
              <li class="flex gap-3.5 rounded-[10px] border border-[#D8C8B5] bg-[#F5F0E8]/40 p-3.5">
                <img src={`/uploads/${a.filename}`} alt={a.originalName} loading="lazy"
                  class="h-20 w-20 shrink-0 rounded-[8px] border border-[#D8C8B5] object-cover" />
                <div class="min-w-0 flex-1">
                  <p class="truncate text-xs text-[#6C5E54]">{a.originalName}</p>
                  <label class="sr-only" for={`role_${a.id}`}>Dipakai sebagai</label>
                  <select id={`role_${a.id}`} name={`role_${a.id}`} class="input-field mt-1.5 py-1.5 text-xs">
                    {PHOTO_ROLES.map((r) => (
                      <option value={r.value} selected={v(`role_${a.id}`) === r.value}>{r.label}</option>
                    ))}
                  </select>
                  {e(`role_${a.id}`) && <p class="mt-1 text-xs text-[#A34E4E]">{e(`role_${a.id}`)}</p>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      )
    )}

    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-[#D8C8B5]/80 pt-6">
      <div class="flex items-center gap-3">
        <button class="btn-primary">
          {isLast ? 'Simpan & Selesai' : 'Simpan & Lanjut'}
        </button>
        {step.n > 1 && (
          <a href={`/dashboard/invitations/${id}/form?step=${step.n - 1}`} class="btn-secondary">
            Langkah Sebelumnya
          </a>
        )}
      </div>
      <a href={`/dashboard/invitations/${id}`} class="text-xs font-medium text-[#6C5E54] underline underline-offset-4 hover:text-[#493D35]">
        Keluar ke Ringkasan
      </a>
    </div>
  </form>
</AppLayout>