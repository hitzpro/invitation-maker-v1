---
import AppLayout from '../../../../layouts/AppLayout.astro';
import Field from '../../../../components/Field.astro';
import UploadBox from '../../../../components/UploadBox.astro';
import { getOwnedInvitation, listAssets } from '../../../../lib/invitations.js';
import { MAX_ASSETS_PER_INVITATION } from '../../../../lib/upload.js';
import {
  EVENT_SLOTS, PHOTO_ROLES, STORY_SLOTS, TIMEZONES,
  applyStep, getInvitationContent, toFormValues, updateInvitationContent, validateStep,
} from '../../../../lib/content.js';

const STEPS = [
  { n: 1, key: 'couple', label: 'Mempelai' },
  { n: 2, key: 'event', label: 'Acara' },
  { n: 3, key: 'story', label: 'Cerita & Penutup' },
  { n: 4, key: 'photos', label: 'Foto' },
];

const user = Astro.locals.user;
const { id } = Astro.params;

const inv = await getOwnedInvitation(id, user.id);
if (!inv) return Astro.rewrite('/404');
if (inv.method !== 'automatic') return Astro.redirect(`/dashboard/invitations/${id}`);

const requested = Number(Astro.url.searchParams.get('step') ?? 1);
const step = STEPS.find((s) => s.n === requested) ?? STEPS[0];
const isLast = step.n === STEPS.length;

const content = await getInvitationContent(inv.id);
const assets = step.key === 'photos' ? await listAssets(inv.id) : [];

let values = toFormValues(step.key, content);
let errors = {};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const raw = Object.fromEntries([...form.entries()].filter(([, v]) => typeof v === 'string'));
  values = raw; // pertahankan isian user kalau ada error

  // assetIds hanya berisi gambar milik undangan ini
  const result = validateStep(step.key, raw, { assetIds: assets.map((a) => a.id) });
  if (result.errors) {
    errors = result.errors;
  } else {
    await updateInvitationContent(inv.id, (c) => applyStep(step.key, c, result.data));
    return Astro.redirect(
      isLast
        ? `/dashboard/invitations/${id}?saved=form`
        : `/dashboard/invitations/${id}/form?step=${step.n + 1}`
    );
  }
}

const v = (name) => values[name] ?? '';
const e = (name) => errors[name] ?? '';
---
<AppLayout title={`Formulir: ${inv.title}`}>
  <a href={`/dashboard/invitations/${id}`} class="text-sm underline">← Kembali ke ringkasan</a>
  <h1 class="text-2xl font-bold mt-2">Isi Undangan</h1>
  <p class="text-sm text-gray-600">{inv.title}</p>
  <a href={`/dashboard/invitations/${id}/preview`} target="_blank" rel="noopener" class="text-sm underline">Lihat preview ↗</a>

  <ol class="mt-4 flex gap-2 flex-wrap text-sm">
    {STEPS.map((s) => (
      <li>
        <a href={`/dashboard/invitations/${id}/form?step=${s.n}`}
          class={'rounded px-3 py-1 border ' + (s.n === step.n ? 'bg-black text-white border-black' : 'hover:bg-gray-100')}>
          {s.n}. {s.label}
        </a>
      </li>
    ))}
  </ol>

  {step.key === 'photos' && (
    <section class="mt-6 max-w-2xl bg-white border rounded-lg p-6">
      <h2 class="font-semibold">Unggah foto</h2>
      <p class="text-sm text-gray-600 mb-3">
        JPEG atau PNG, maksimal 20 MB per file. Bisa memilih beberapa file sekaligus
        ({assets.length}/{MAX_ASSETS_PER_INVITATION} gambar). Unggah dulu, lalu tentukan fungsi tiap foto di bawah.
      </p>
      <UploadBox invitationId={inv.id} />
    </section>
  )}

  <form method="POST" class="mt-6 max-w-2xl bg-white border rounded-lg p-6 space-y-6">
    <h2 class="font-semibold">Langkah {step.n} dari {STEPS.length}: {step.label}</h2>
    {errors._form && <p class="text-sm bg-red-50 text-red-700 border border-red-200 rounded px-3 py-2">{errors._form}</p>}

    {step.key === 'couple' && (
      <>
        <Field name="intro" label="Kalimat pembuka (opsional)" rows="3" maxlength="500"
          value={v('intro')} error={e('intro')}
          hint="Misalnya ayat atau kutipan yang ingin ditampilkan di awal undangan." />

        <fieldset class="space-y-4">
          <legend class="font-medium">Mempelai Wanita</legend>
          <Field name="bride_name" label="Nama panggilan" required maxlength="40" value={v('bride_name')} error={e('bride_name')} />
          <Field name="bride_fullName" label="Nama lengkap" required maxlength="100" value={v('bride_fullName')} error={e('bride_fullName')} />
          <Field name="bride_parents" label="Putri dari (orang tua)" maxlength="200" value={v('bride_parents')} error={e('bride_parents')}
            placeholder="Bapak ... dan Ibu ..." />
        </fieldset>

        <fieldset class="space-y-4">
          <legend class="font-medium">Mempelai Pria</legend>
          <Field name="groom_name" label="Nama panggilan" required maxlength="40" value={v('groom_name')} error={e('groom_name')} />
          <Field name="groom_fullName" label="Nama lengkap" required maxlength="100" value={v('groom_fullName')} error={e('groom_fullName')} />
          <Field name="groom_parents" label="Putra dari (orang tua)" maxlength="200" value={v('groom_parents')} error={e('groom_parents')}
            placeholder="Bapak ... dan Ibu ..." />
        </fieldset>
      </>
    )}

    {step.key === 'event' && (
      <>
        <div>
          <label for="timezone" class="block text-sm font-medium">Zona waktu acara</label>
          <select id="timezone" name="timezone" class="mt-1 border rounded px-3 py-2">
            {Object.entries(TIMEZONES).map(([tz, label]) => (
              <option value={tz} selected={v('timezone') === tz}>{label}</option>
            ))}
          </select>
          {e('timezone') && <p class="text-sm text-red-600 mt-1">{e('timezone')}</p>}
        </div>

        {EVENT_SLOTS.map((slot) => (
          <fieldset class="space-y-4 border rounded-lg p-4">
            <legend class="font-medium px-1">{slot.label}</legend>
            <div class="grid sm:grid-cols-3 gap-4">
              <Field type="date" name={`${slot.key}_date`} label="Tanggal" value={v(`${slot.key}_date`)} error={e(`${slot.key}_date`)} />
              <Field type="time" name={`${slot.key}_startTime`} label="Jam mulai" value={v(`${slot.key}_startTime`)} error={e(`${slot.key}_startTime`)} />
              <Field type="time" name={`${slot.key}_endTime`} label="Jam selesai (opsional)" value={v(`${slot.key}_endTime`)} error={e(`${slot.key}_endTime`)} />
            </div>
            <Field name={`${slot.key}_venue`} label="Nama tempat" maxlength="120" value={v(`${slot.key}_venue`)} error={e(`${slot.key}_venue`)} />
            <Field name={`${slot.key}_address`} label="Alamat lengkap" rows="2" maxlength="300" value={v(`${slot.key}_address`)} error={e(`${slot.key}_address`)} />
            <p class="text-xs text-gray-600">Kosongkan seluruh isian jika acara ini tidak diadakan.</p>
          </fieldset>
        ))}

        <Field name="mapsUrl" type="url" label="Tautan Google Maps (opsional)" maxlength="500"
          value={v('mapsUrl')} error={e('mapsUrl')} placeholder="https://maps.app.goo.gl/..."
          hint="Lokasi di undangan mengikuti acara pertama yang kamu isi." />
      </>
    )}

    {step.key === 'story' && (
      <>
        <p class="text-sm text-gray-600">Cerita bersifat opsional. Kosongkan jika tidak ingin menampilkannya.</p>
        {Array.from({ length: STORY_SLOTS }, (_, i) => i + 1).map((i) => (
          <fieldset class="space-y-4 border rounded-lg p-4">
            <legend class="font-medium px-1">Cerita {i}</legend>
            <div class="grid sm:grid-cols-2 gap-4">
              <Field name={`story${i}_title`} label="Judul" maxlength="80" value={v(`story${i}_title`)} error={e(`story${i}_title`)} placeholder="Pertemuan pertama" />
              <Field name={`story${i}_date`} label="Waktu" maxlength="40" value={v(`story${i}_date`)} error={e(`story${i}_date`)} placeholder="Mei 2019" />
            </div>
            <Field name={`story${i}_text`} label="Cerita" rows="3" maxlength="600" value={v(`story${i}_text`)} error={e(`story${i}_text`)} />
          </fieldset>
        ))}

        <Field name="closing" label="Pesan penutup (opsional)" rows="3" maxlength="600"
          value={v('closing')} error={e('closing')} />
      </>
    )}

    {step.key === 'photos' && (
      assets.length === 0 ? (
        <p class="text-sm text-gray-600">Belum ada foto. Unggah dulu lewat kotak di atas, atau langsung selesaikan formulir tanpa foto.</p>
      ) : (
        <>
          <p class="text-sm text-gray-600">
            Cover, foto mempelai wanita, dan foto mempelai pria masing-masing hanya bisa satu gambar.
            Gambar berperan "Galeri" tampil sesuai urutan unggah.
          </p>
          <ul class="grid sm:grid-cols-2 gap-4">
            {assets.map((a) => (
              <li class="border rounded-lg p-3 flex gap-3">
                <img src={`/uploads/${a.filename}`} alt={a.originalName} loading="lazy"
                  class="w-24 h-24 object-cover rounded border shrink-0" />
                <div class="flex-1 min-w-0">
                  <p class="text-xs text-gray-600 truncate">{a.originalName}</p>
                  <label class="sr-only" for={`role_${a.id}`}>Dipakai sebagai</label>
                  <select id={`role_${a.id}`} name={`role_${a.id}`} class="mt-1 w-full border rounded px-2 py-1 text-sm">
                    {PHOTO_ROLES.map((r) => (
                      <option value={r.value} selected={v(`role_${a.id}`) === r.value}>{r.label}</option>
                    ))}
                  </select>
                  {e(`role_${a.id}`) && <p class="text-sm text-red-600 mt-1">{e(`role_${a.id}`)}</p>}
                </div>
              </li>
            ))}
          </ul>
        </>
      )
    )}

    <div class="flex items-center gap-3">
      <button class="bg-black text-white rounded px-4 py-2 text-sm">
        {isLast ? 'Simpan & Selesai' : 'Simpan & Lanjut'}
      </button>
      {step.n > 1 && (
        <a href={`/dashboard/invitations/${id}/form?step=${step.n - 1}`} class="text-sm underline">Langkah sebelumnya</a>
      )}
    </div>
  </form>
</AppLayout>