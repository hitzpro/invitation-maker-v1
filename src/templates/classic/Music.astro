---
const { content, images } = Astro.props;
const { assetId, autoplay, loop, volume } = content.music;
const track = assetId ? images.get(assetId) : null;
---
{track?.audio && (
  <>
    <audio id="inv-audio" src={track.url} preload="none" loop={loop}
      data-autoplay={autoplay ? 'true' : 'false'} data-volume={volume}></audio>
    <button type="button" id="inv-audio-btn" class="music-btn" aria-label="Putar musik" aria-pressed="false">
      <svg data-icon="play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
      <svg data-icon="pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
    </button>
  </>
)}

<script>
  const audio = document.getElementById('inv-audio');
  const button = document.getElementById('inv-audio-btn');

  if (audio && button) {
    const volume = Number(audio.dataset.volume);
    audio.volume = Number.isFinite(volume) ? Math.min(100, Math.max(0, volume)) / 100 : 0.7;

    const sync = () => {
      button.dataset.state = audio.paused ? 'paused' : 'playing';
      button.setAttribute('aria-pressed', String(!audio.paused));
      button.setAttribute('aria-label', audio.paused ? 'Putar musik' : 'Jeda musik');
    };
    audio.addEventListener('play', sync);
    audio.addEventListener('pause', sync);
    sync();

    button.addEventListener('click', () => {
      if (audio.paused) audio.play().catch(() => {});
      else audio.pause();
    });

    // Autoplay: dicoba langsung, dan bila diblokir browser, dimulai pada interaksi pertama tamu.
    // Dinonaktifkan di dalam iframe (preview editor).
    if (audio.dataset.autoplay === 'true' && window.self === window.top) {
      const events = ['click', 'touchend', 'keydown'];
      const cleanup = () => events.forEach((ev) => document.removeEventListener(ev, onGesture, true));
      const onGesture = (e) => {
        if (button.contains(e.target)) return; // tombol musik punya aksinya sendiri
        cleanup();
        audio.play().catch(() => {});
      };

      events.forEach((ev) => document.addEventListener(ev, onGesture, true));
      audio.addEventListener('play', cleanup, { once: true });
      audio.play().catch(() => {});
    }
  }
</script>