---
import { FRAMES } from '../../../lib/content.js';

const { content, images } = Astro.props;
const { couple } = content.sections;

const layout = couple.style?.layout === 'split' ? 'split' : 'centered';
const frame = FRAMES.includes(couple.style?.frame) ? couple.style.frame : 'circle';

const clampPct = (v) => Math.min(100, Math.max(0, Math.round(Number(v) || 50)));
const people = [
  { person: couple.bride, label: 'Putri dari', image: images.get(couple.bride.photoId) },
  { person: couple.groom, label: 'Putra dari', image: images.get(couple.groom.photoId) },
];
---
<section id="couple" data-layout={layout} class="px-6 py-16 text-center">
  <h2 class="inv-title text-3xl">Mempelai</h2>
  {couple.intro && <p class="mt-4 text-sm leading-relaxed whitespace-pre-line">{couple.intro}</p>}

  <div class={'mt-10 ' + (layout === 'split' ? 'grid grid-cols-2 items-start gap-4' : 'space-y-6')}>
    {people.map(({ person, label, image }, i) => (
      <>
        {layout === 'centered' && i === 1 && <p class="fx-h inv-title text-4xl">&amp;</p>}
        <article>
          {image && (
            <button type="button" data-couple-zoom={image.url} data-couple-name={person.fullName || person.name}
              aria-label={`Perbesar foto ${person.name}`}
              class={`frame frame-${frame} frame-interactive block cursor-zoom-in`}>
              <img src={image.thumb} width={image.width} height={image.height} alt={person.name}
                style={`object-position: ${clampPct(person.photoPos?.x)}% ${clampPct(person.photoPos?.y)}%`}
                loading="lazy" decoding="async" />
            </button>
          )}
          <h3 class={'mt-4 ' + (layout === 'split' ? 'text-xl' : 'text-2xl')}>{person.fullName || person.name}</h3>
          {person.parents && <p class="inv-muted mt-1 text-sm">{label} {person.parents}</p>}
        </article>
      </>
    ))}
  </div>
</section>

<dialog data-couple-dialog class="m-auto max-h-[92vh] max-w-[92vw] border-0 bg-transparent p-0 backdrop:bg-[#493D35]/85">
  <div class="relative">
    <img data-couple-dialog-img alt="" class="max-h-[88vh] max-w-[92vw] rounded-[10px] object-contain" />
    <button type="button" data-couple-dialog-close aria-label="Tutup"
      class="absolute right-2.5 top-2.5 rounded-[8px] border border-[#D8C8B5] bg-[#FFFFFF]/95 px-3 py-1.5 text-xs font-medium text-[#493D35]">
      Tutup
    </button>
  </div>
</dialog>

<script>
  const dialog = document.querySelector('[data-couple-dialog]');
  const dialogImg = dialog?.querySelector('[data-couple-dialog-img]');
  if (dialog && dialogImg) {
    document.querySelectorAll('[data-couple-zoom]').forEach((btn) => {
      btn.addEventListener('click', () => {
        dialogImg.src = btn.dataset.coupleZoom;
        dialogImg.alt = btn.dataset.coupleName || '';
        document.documentElement.style.overflow = 'hidden';
        dialog.showModal();
      });
    });
    dialog.addEventListener('close', () => { document.documentElement.style.overflow = ''; });
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.querySelector('[data-couple-dialog-close]')?.addEventListener('click', () => dialog.close());
  }
</script>