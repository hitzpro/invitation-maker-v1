---
const { content, images } = Astro.props;
const { intro, qrisImageId, accounts } = content.sections.gift;
const validAccounts = (accounts ?? []).filter((a) => a.bank?.trim() && a.number?.trim());
const qris = images.get(qrisImageId);
---
<section id="gift" class="px-6 py-16 text-center">
  <h2 class="inv-title text-3xl">Amplop Digital</h2>
  {intro && <p class="inv-muted mx-auto mt-3 max-w-md text-sm leading-relaxed whitespace-pre-line">{intro}</p>}

  <div class="mx-auto mt-8 max-w-md space-y-4">
    {validAccounts.map((acc) => (
      <div class="rounded-xl border border-stone-200 bg-white p-5 text-stone-800 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-wider text-stone-500">{acc.bank}</p>
        <p class="mt-1 text-xl font-bold tracking-wide">{acc.number}</p>
        {acc.holder && <p class="mt-1 text-sm text-stone-600">a.n. {acc.holder}</p>}
        <button type="button" data-copy-rek={acc.number}
          class="inv-btn mt-3 rounded-full px-4 py-1.5 text-xs">
          Salin Nomor
        </button>
      </div>
    ))}

    {qris && (
      <div class="rounded-xl border border-stone-200 bg-white p-5 text-stone-800 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-wider text-stone-500">QRIS</p>
        <img src={qris.medium} alt="QRIS" loading="lazy" class="mx-auto mt-3 max-h-64 w-auto rounded border" />
      </div>
    )}
  </div>
</section>

<script>
  document.querySelectorAll('[data-copy-rek]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(btn.dataset.copyRek);
      const old = btn.textContent;
      btn.textContent = 'Tersalin';
      setTimeout(() => (btn.textContent = old), 1500);
    });
  });
</script>