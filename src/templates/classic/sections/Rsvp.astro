---
const { invitation, guestName = '' } = Astro.props;
const isDemo = invitation.id === 'demo-showcase';
const isPublished = invitation.status === 'published' && !invitation.isDisabled;
---
<section id="rsvp" class="px-6 py-16">
  <h2 class="inv-title text-center text-3xl">Konfirmasi Kehadiran</h2>
  <p class="inv-muted mt-2 text-center text-sm">Mohon konfirmasi kehadiran Anda melalui formulir di bawah ini.</p>

  <form data-rsvp-form data-slug={invitation.slug} data-active={isPublished ? '1' : ''}
    class="mx-auto mt-8 max-w-md space-y-4 rounded-[14px] border border-[#D8C8B5] bg-[#FFFFFF] p-6 text-left text-[#493D35]">
    <div class="sr-only" aria-hidden="true">
      <label>Situs web <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>

    <div>
      <label for="rsvp-name" class="block text-xs font-medium text-[#6C5E54]">Nama tamu</label>
      <input id="rsvp-name" name="guestName" type="text" required minlength="2" maxlength="60"
        value={guestName} placeholder="Nama Anda"
        class="mt-1.5 w-full rounded-[9px] border border-[#D8C8B5] bg-[#FFFFFF] px-3 py-2 text-sm text-[#493D35]" />
    </div>

    <div>
      <label for="rsvp-attendance" class="block text-xs font-medium text-[#6C5E54]">Kehadiran</label>
      <select id="rsvp-attendance" name="attendance" required
        class="mt-1.5 w-full rounded-[9px] border border-[#D8C8B5] bg-[#FFFFFF] px-3 py-2 text-sm text-[#493D35]">
        <option value="hadir">Hadir</option>
        <option value="tidak_hadir">Tidak hadir</option>
        <option value="ragu">Masih ragu</option>
      </select>
    </div>

    <div data-rsvp-count-wrap>
      <label for="rsvp-count" class="block text-xs font-medium text-[#6C5E54]">Jumlah tamu</label>
      <input id="rsvp-count" name="guestCount" type="number" min="1" max="10" value="1" required
        class="mt-1.5 w-full rounded-[9px] border border-[#D8C8B5] bg-[#FFFFFF] px-3 py-2 text-sm text-[#493D35]" />
    </div>

    {!isPublished && (
      <p class="text-xs text-[#B17C42]">
        {isDemo
          ? 'Mode demo showcase: pengisian RSVP aktif penuh setelah repo di-clone dan dijalankan secara lokal.'
          : 'Mode preview: formulir aktif setelah undangan dipublikasikan.'}
      </p>
    )}

    <p data-rsvp-status class="hidden text-sm"></p>

    <button type="submit" disabled={!isPublished}
      class="inv-btn w-full rounded-[8px] px-6 py-2.5 text-sm font-medium disabled:opacity-50">
      Kirim Konfirmasi
    </button>
  </form>
</section>

<script>
  document.querySelectorAll('[data-rsvp-form]').forEach((form) => {
    const attendanceEl = form.querySelector('[name="attendance"]');
    const countWrap = form.querySelector('[data-rsvp-count-wrap]');
    const countEl = form.querySelector('[name="guestCount"]');
    const statusEl = form.querySelector('[data-rsvp-status]');
    const submitBtn = form.querySelector('button[type="submit"]');

    const syncCount = () => {
      const hadir = attendanceEl.value === 'hadir';
      countWrap.classList.toggle('hidden', !hadir);
      countEl.disabled = !hadir;
    };
    attendanceEl.addEventListener('change', syncCount);
    syncCount();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.dataset.active) return;

      statusEl.className = 'hidden text-sm';
      submitBtn.disabled = true;
      submitBtn.textContent = 'Mengirim...';

      const fd = new FormData(form);
      const payload = {
        guestName: String(fd.get('guestName') ?? ''),
        attendance: String(fd.get('attendance') ?? 'hadir'),
        guestCount: Number(fd.get('guestCount') ?? 1),
        website: String(fd.get('website') ?? ''),
      };

      try {
        const res = await fetch(`/api/public/${encodeURIComponent(form.dataset.slug)}/rsvp`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error ?? 'Gagal mengirim konfirmasi');

        statusEl.textContent = 'Terima kasih, konfirmasi kehadiran Anda telah tersimpan.';
        statusEl.className = 'text-sm text-[#58765D]';
        form.reset();
        syncCount();
      } catch (err) {
        statusEl.textContent = err.message;
        statusEl.className = 'text-sm text-[#A34E4E]';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Kirim Konfirmasi';
      }
    });
  });
</script>