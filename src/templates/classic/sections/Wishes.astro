---
const { invitation, wishes = [], hasMoreWishes = false, guestName = '' } = Astro.props;
const isPublished = invitation.status === 'published' && !invitation.isDisabled;
const fmt = new Intl.DateTimeFormat('id-ID', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Jakarta' });
---
<section id="wishes" class="px-6 py-16">
  <h2 class="inv-title text-center text-3xl">Ucapan &amp; Doa</h2>
  <p class="inv-muted mt-2 text-center text-sm">Kirimkan doa dan ucapan terbaik untuk kedua mempelai.</p>

  <form data-wish-form data-slug={invitation.slug} data-active={isPublished ? '1' : ''}
    class="mx-auto mt-8 max-w-md space-y-4 rounded-xl border border-stone-200 bg-white p-6 text-left text-stone-800 shadow-sm">
    <div class="sr-only" aria-hidden="true">
      <label>Situs web <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>

    <div>
      <label for="wish-name" class="block text-xs font-medium text-stone-600">Nama</label>
      <input id="wish-name" name="guestName" type="text" required minlength="2" maxlength="60"
        value={guestName} placeholder="Nama Anda"
        class="mt-1 w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm text-stone-800" />
    </div>

    <div>
      <label for="wish-message" class="block text-xs font-medium text-stone-600">Ucapan &amp; doa</label>
      <textarea id="wish-message" name="message" rows="3" required minlength="3" maxlength="500"
        placeholder="Tulis ucapan dan doa..."
        class="mt-1 w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm text-stone-800"></textarea>
    </div>

    {!isPublished && (
      <p class="text-xs text-amber-700">Mode preview: formulir aktif setelah undangan dipublikasikan.</p>
    )}

    <p data-wish-status class="hidden text-sm"></p>

    <button type="submit" disabled={!isPublished}
      class="inv-btn w-full rounded-full px-6 py-2.5 text-sm font-medium disabled:opacity-50">
      Kirim Ucapan
    </button>
  </form>

  <div class="mx-auto mt-8 max-w-md">
    <p data-wish-empty class={'inv-muted text-center text-sm ' + (wishes.length > 0 ? 'hidden' : '')}>
      Belum ada ucapan. Jadilah yang pertama memberi doa.
    </p>

    <ul data-wish-list class="space-y-3 text-left">
      {wishes.map((w) => (
        <li class="rounded-xl border border-stone-200 bg-white p-4 text-stone-800 shadow-sm">
          <div class="flex items-baseline justify-between gap-2">
            <p class="text-sm font-semibold">{w.guestName}</p>
            <time class="text-[11px] text-stone-400">{fmt.format(new Date(w.createdAt))}</time>
          </div>
          <p class="mt-1.5 text-sm leading-relaxed whitespace-pre-line text-stone-700">{w.message}</p>
        </li>
      ))}
    </ul>

    {hasMoreWishes && isPublished && (
      <div class="mt-4 text-center">
        <button type="button" data-wish-more data-offset={wishes.length}
          class="rounded-full border border-current px-5 py-2 text-xs hover:opacity-80">
          Muat ucapan lainnya
        </button>
      </div>
    )}
  </div>
</section>

<script>
  const fmt = new Intl.DateTimeFormat('id-ID', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Jakarta' });

  function renderWishItem(item) {
    const li = document.createElement('li');
    li.className = 'rounded-xl border border-stone-200 bg-white p-4 text-stone-800 shadow-sm';

    const head = document.createElement('div');
    head.className = 'flex items-baseline justify-between gap-2';

    const name = document.createElement('p');
    name.className = 'text-sm font-semibold';
    name.textContent = item.guestName;

    const time = document.createElement('time');
    time.className = 'text-[11px] text-stone-400';
    time.textContent = fmt.format(new Date(item.createdAt));

    const msg = document.createElement('p');
    msg.className = 'mt-1.5 text-sm leading-relaxed whitespace-pre-line text-stone-700';
    msg.textContent = item.message;

    head.append(name, time);
    li.append(head, msg);
    return li;
  }

  document.querySelectorAll('[data-wish-form]').forEach((form) => {
    const section = form.closest('#wishes');
    const list = section.querySelector('[data-wish-list]');
    const emptyEl = section.querySelector('[data-wish-empty]');
    const statusEl = form.querySelector('[data-wish-status]');
    const submitBtn = form.querySelector('button[type="submit"]');
    const moreBtn = section.querySelector('[data-wish-more]');
    const slug = form.dataset.slug;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.dataset.active) return;

      statusEl.className = 'hidden text-sm';
      submitBtn.disabled = true;
      submitBtn.textContent = 'Mengirim...';

      const fd = new FormData(form);
      const payload = {
        guestName: String(fd.get('guestName') ?? ''),
        message: String(fd.get('message') ?? ''),
        website: String(fd.get('website') ?? ''),
      };

      try {
        const res = await fetch(`/api/public/${encodeURIComponent(slug)}/wishes`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error ?? 'Gagal mengirim ucapan');

        list.prepend(renderWishItem(data.item));
        emptyEl.classList.add('hidden');
        if (moreBtn) moreBtn.dataset.offset = String(Number(moreBtn.dataset.offset) + 1);

        statusEl.textContent = 'Ucapan Anda telah ditambahkan.';
        statusEl.className = 'text-sm text-green-700';
        form.querySelector('[name="message"]').value = '';
      } catch (err) {
        statusEl.textContent = err.message;
        statusEl.className = 'text-sm text-red-600';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Kirim Ucapan';
      }
    });

    moreBtn?.addEventListener('click', async () => {
      moreBtn.disabled = true;
      const offset = Number(moreBtn.dataset.offset) || 0;
      try {
        const res = await fetch(`/api/public/${encodeURIComponent(slug)}/wishes?offset=${offset}`);
        const data = await res.json().catch(() => ({}));
        if (!res.ok) return;
        for (const item of data.items ?? []) list.append(renderWishItem(item));
        moreBtn.dataset.offset = String(offset + (data.items?.length ?? 0));
        if (!data.hasMore) moreBtn.remove();
      } finally {
        if (moreBtn.isConnected) moreBtn.disabled = false;
      }
    });
  });
</script>