---
import { GALLERY_LAYOUTS } from '../../../lib/content.js';

const { content, images, animate } = Astro.props;
const { imageIds, style } = content.sections.gallery;
const photos = imageIds.map((id) => images.get(id)).filter(Boolean);
const layout = GALLERY_LAYOUTS.includes(style?.layout) ? style.layout : 'grid';

const containerClass = {
  grid: 'grid grid-cols-2 gap-2',
  carousel: 'flex snap-x snap-mandatory gap-3 overflow-x-auto pb-3',
  masonry: 'columns-2 gap-2',
  mosaic: 'grid grid-cols-3 auto-rows-[7rem] gap-2',
}[layout];

const itemClass = (i) =>
  ({
    grid: 'block overflow-hidden rounded',
    carousel: 'block w-[72%] shrink-0 snap-center overflow-hidden rounded',
    masonry: 'mb-2 block break-inside-avoid overflow-hidden rounded',
    mosaic: 'block overflow-hidden rounded ' + (i % 5 === 0 ? 'col-span-2 row-span-2' : ''),
  })[layout];

const imageClass = {
  grid: 'aspect-square w-full object-cover',
  carousel: 'aspect-[4/5] w-full object-cover',
  masonry: 'h-auto w-full',
  mosaic: 'h-full w-full object-cover',
}[layout];

// Tile besar mosaik dan carousel memakai versi lebih besar
const sourceOf = (photo, i) =>
  layout === 'carousel' || (layout === 'mosaic' && i % 5 === 0) ? photo.medium : photo.thumb;
---
<section id="gallery" class="px-6 py-16">
  <h2 class="inv-title text-center text-3xl">Galeri</h2>

  <div class={`mt-8 ${containerClass}`}>
    {photos.map((photo, i) => (
      <button
        type="button"
        data-lightbox-open
        data-full={photo.url}
        aria-label={`Perbesar foto ${i + 1}`}
        class={`${itemClass(i)} group relative cursor-zoom-in`}
        data-reveal-item={animate ? '' : undefined}
        style={animate ? `--reveal-delay: ${Math.min(i, 6) * 90}ms` : undefined}
      >
        <img
          src={sourceOf(photo, i)}
          width={photo.width}
          height={photo.height}
          alt={`Foto galeri ${i + 1}`}
          loading="lazy"
          decoding="async"
          class={`${imageClass} gal-img`}
        />
      </button>
    ))}
  </div>

  <dialog
    data-lightbox
    class="m-auto max-h-[95vh] max-w-[95vw] border-0 bg-transparent p-0 backdrop:bg-[#493D35]/90"
  >
    <div class="relative select-none">
      <div data-lightbox-stage class="overflow-hidden rounded-[10px]">
        <img
          data-lightbox-img
          alt=""
          draggable="false"
          class="max-h-[82vh] max-w-[95vw] origin-center object-contain transition-transform duration-150"
        />
      </div>

      <div class="mt-3 flex flex-wrap items-center justify-center gap-2 text-xs text-white">
        <button type="button" data-lightbox-prev aria-label="Foto sebelumnya"
          class="rounded-[8px] border border-white/25 bg-[#493D35]/85 px-3 py-1.5">
          Sebelumnya
        </button>
        <span data-lightbox-counter class="rounded-[8px] border border-white/20 bg-[#493D35]/85 px-3 py-1.5 tabular-nums"></span>
        <button type="button" data-zoom-out aria-label="Perkecil"
          class="rounded-[8px] border border-white/25 bg-[#493D35]/85 px-3 py-1.5">
          Perkecil
        </button>
        <button type="button" data-zoom-reset
          class="rounded-[8px] border border-white/25 bg-[#493D35]/85 px-3 py-1.5 tabular-nums">
          100%
        </button>
        <button type="button" data-zoom-in aria-label="Perbesar"
          class="rounded-[8px] border border-white/25 bg-[#493D35]/85 px-3 py-1.5">
          Perbesar
        </button>
        <button type="button" data-lightbox-next aria-label="Foto berikutnya"
          class="rounded-[8px] border border-white/25 bg-[#493D35]/85 px-3 py-1.5">
          Berikutnya
        </button>
        <button type="button" data-lightbox-close aria-label="Tutup"
          class="rounded-[8px] border border-white/25 bg-[#8B7561] px-3 py-1.5 font-medium text-white">
          Tutup
        </button>
      </div>
    </div>
  </dialog>
</section>

<script>
  const section = document.getElementById('gallery');
  if (section) {
    const dialog = section.querySelector('[data-lightbox]');
    const bigImg = dialog.querySelector('[data-lightbox-img]');
    const counter = dialog.querySelector('[data-lightbox-counter]');
    const resetBtn = dialog.querySelector('[data-zoom-reset]');
    const openers = [...section.querySelectorAll('[data-lightbox-open]')];
    const prev = dialog.querySelector('[data-lightbox-prev]');
    const next = dialog.querySelector('[data-lightbox-next]');

    let index = 0;
    let scale = 1;
    let tx = 0;
    let ty = 0;
    let dragging = false;
    let dragStart = null;

    if (openers.length < 2) {
      prev.classList.add('hidden');
      next.classList.add('hidden');
    }

    const applyTransform = () => {
      if (scale <= 1) { tx = 0; ty = 0; }
      bigImg.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
      bigImg.style.cursor = scale > 1 ? (dragging ? 'grabbing' : 'grab') : 'zoom-in';
      resetBtn.textContent = `${Math.round(scale * 100)}%`;
    };

    const setZoom = (nextScale) => {
      scale = Math.min(3, Math.max(1, Math.round(nextScale * 10) / 10));
      applyTransform();
    };

    const show = (i) => {
      index = (i + openers.length) % openers.length;
      bigImg.src = openers[index].dataset.full;
      bigImg.alt = openers[index].querySelector('img').alt;
      counter.textContent = `${index + 1} / ${openers.length}`;
      setZoom(1);
    };

    openers.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        show(i);
        document.documentElement.style.overflow = 'hidden';
        dialog.showModal();
      });
    });

    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      setZoom(1);
    });
    dialog.querySelector('[data-lightbox-close]').addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-zoom-in]').addEventListener('click', () => setZoom(scale + 0.5));
    dialog.querySelector('[data-zoom-out]').addEventListener('click', () => setZoom(scale - 0.5));
    resetBtn.addEventListener('click', () => setZoom(1));
    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));

    // Double-click untuk toggle zoom 1x <-> 2x
    bigImg.addEventListener('dblclick', () => setZoom(scale > 1 ? 1 : 2));

    // Scroll wheel untuk zoom
    bigImg.addEventListener('wheel', (e) => {
      e.preventDefault();
      setZoom(scale + (e.deltaY < 0 ? 0.3 : -0.3));
    }, { passive: false });

    // Geser gambar saat sedang zoom (pointer)
    bigImg.addEventListener('pointerdown', (e) => {
      if (scale <= 1) return;
      dragging = true;
      dragStart = { x: e.clientX - tx, y: e.clientY - ty };
      bigImg.setPointerCapture(e.pointerId);
      applyTransform();
    });
    bigImg.addEventListener('pointermove', (e) => {
      if (!dragging || !dragStart) return;
      tx = e.clientX - dragStart.x;
      ty = e.clientY - dragStart.y;
      applyTransform();
    });
    const endDrag = () => { dragging = false; dragStart = null; applyTransform(); };
    bigImg.addEventListener('pointerup', endDrag);
    bigImg.addEventListener('pointercancel', endDrag);

    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('keydown', (e) => {
      if (openers.length < 2) return;
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });

    // Swipe pindah foto hanya saat tidak sedang di-zoom
    let startX = null;
    dialog.addEventListener('touchstart', (e) => {
      if (scale === 1) startX = e.touches[0].clientX;
    }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      if (startX === null || scale > 1 || openers.length < 2) return;
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
      startX = null;
    });
  }
</script>