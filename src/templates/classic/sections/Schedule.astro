---
import { formatDate, formatTime, sortedEvents } from '../../../lib/render-data.js';

const { content } = Astro.props;
const timezone = content.sections.event.timezone;
const layout = content.sections.event.style?.layout === 'split' ? 'split' : 'centered';
const events = sortedEvents(content);
const split = layout === 'split';
---
<section id="schedule" class="px-6 py-16 text-center">
  <h2 class="inv-title text-3xl">Acara</h2>
  <div class={'mt-10 ' + (split ? 'grid grid-cols-2 gap-3' : 'space-y-6')}>
    {events.map((ev) => (
      <article class={
        'inv-line rounded-xl border bg-white text-stone-800 shadow-sm ' +
        (split ? 'px-4 py-6 ' : 'px-6 py-8 ') +
        (split && events.length === 1 ? 'col-span-2' : '')
      }>
        <h3 class={split ? 'text-xl' : 'text-2xl'}>{ev.label}</h3>
        <p class="mt-3">{formatDate(ev.date)}</p>
        <p class="text-sm text-stone-600">{formatTime(ev, timezone)}</p>
        {ev.venue && <p class="fx-h mt-4 font-semibold">{ev.venue}</p>}
        {ev.address && <p class="text-sm text-stone-600 whitespace-pre-line">{ev.address}</p>}
      </article>
    ))}
  </div>
</section>