---
import '../styles/global.css';
import { getAppName } from '../lib/settings.js';
import { getCreatorBranding } from '../lib/branding.js';
import stationeryImg from '../assets/images/wedding_stationery_detail_1795595645576.jpg';

const { title = 'Masuk', subtitle = '' } = Astro.props;
const appName = await getAppName();
const creator = getCreatorBranding();
---
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {appName}</title>
  </head>
  <body class="min-h-screen bg-[#F5F0E8] text-[#493D35] antialiased">
    <div class="min-h-screen lg:grid lg:grid-cols-[1.05fr_1fr]">
      {/* Visual Editorial Panel (Desktop) */}
      <aside class="hidden lg:flex lg:flex-col lg:justify-between border-r border-[#D8C8B5] bg-[#EFE8DC] p-12">
        <div>
          <a href="/" class="font-display text-2xl font-medium tracking-tight text-[#493D35]">
            {appName}
          </a>
        </div>

        <div class="mx-auto my-8 w-full max-w-md">
          <div class="overflow-hidden rounded-[14px] border border-[#D8C8B5] bg-white p-2.5">
            <img src={stationeryImg.src} alt="Set undangan pernikahan bergaya minimalis klasik"
              class="aspect-[3/4] w-full rounded-[10px] object-cover" />
          </div>
          <p class="font-display mt-6 text-xl italic leading-snug text-[#493D35]">
            "Setiap kisah cinta layak dibagikan dalam bentuk yang tenang, personal, dan abadi."
          </p>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3 text-xs text-[#6C5E54]">
          <a href="/" class="underline underline-offset-4 hover:text-[#493D35]">Kembali ke beranda</a>
          <span>
            Dibuat oleh{' '}
            <a href={creator.githubUrl} target="_blank" rel="noopener noreferrer"
              class="font-medium text-[#493D35] underline underline-offset-4 hover:text-[#8B7561]">
              {creator.displayHandle}
            </a>
          </span>
        </div>
      </aside>

      {/* Form Panel */}
      <main class="flex min-h-screen flex-col justify-center px-5 py-10 sm:px-10">
        <div class="mx-auto w-full max-w-md">
          <div class="mb-8 flex items-center justify-between lg:hidden">
            <a href="/" class="font-display text-xl font-medium text-[#493D35]">{appName}</a>
            <div class="flex items-center gap-3">
              <a href={creator.repoUrl} target="_blank" rel="noopener noreferrer"
                aria-label="Repositori GitHub"
                class="inline-flex h-8 w-8 items-center justify-center rounded-[8px] border border-[#D8C8B5] bg-[#FFFFFF] text-[#493D35] hover:border-[#8B7561]">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                </svg>
              </a>
              <a href="/" class="text-xs text-[#6C5E54] underline underline-offset-4">Beranda</a>
            </div>
          </div>

          <div class="surface-panel p-7 sm:p-9">
            <h1 class="font-display text-3xl font-medium tracking-tight text-[#493D35]">{title}</h1>
            {subtitle && <p class="mt-2 text-sm text-[#6C5E54]">{subtitle}</p>}

            <div class="mt-6">
              <slot />
            </div>
          </div>

          <p class="mt-6 text-center text-xs text-[#6C5E54] lg:hidden">
            Proyek ini dibuat oleh{' '}
            <a href={creator.githubUrl} target="_blank" rel="noopener noreferrer"
              class="font-medium text-[#493D35] underline underline-offset-4">
              {creator.displayHandle}
            </a>
          </p>
        </div>
      </main>
    </div>
  </body>
</html>
