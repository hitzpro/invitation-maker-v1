---
import '../styles/global.css';
const { title = 'Dashboard' } = Astro.props;
const user = Astro.locals.user;
---
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Undangan Digital</title>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <header class="bg-white border-b">
      <div class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between">
        <a href="/dashboard" class="font-bold">Undangan Digital</a>
        <nav class="flex items-center gap-4 text-sm">
          {user?.role === 'admin' && <a href="/admin" class="underline">Admin</a>}
          <span class="hidden sm:inline text-gray-600">{user?.name}</span>
          <form method="POST" action="/api/logout">
            <button class="border rounded px-3 py-1 hover:bg-gray-100">Keluar</button>
          </form>
        </nav>
      </div>
    </header>
    <main class="max-w-5xl mx-auto px-4 py-8">
      <slot />
    </main>
  </body>
</html>